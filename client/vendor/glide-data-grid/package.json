{
  "name": "@glideapps/glide-data-grid",
  "version": "6.0.4-alpha24",
  "description": "React data grid for beautifully displaying and editing large amounts of data with amazing performance.",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "browser": "dist/esm/index.js",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/dts/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/dts/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./dist/index.css": {
      "import": "./dist/index.css",
      "require": "./dist/index.css"
    },
    "./index.css": {
      "import": "./dist/index.css",
      "require": "./dist/index.css"
    }
  },
  "scripts": {},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glideapps/glide-data-grid.git",
    "directory": "packages/core"
  },
  "keywords": [
    "react",
    "datagrid",
    "data-grid",
    "editor",
    "reactjs",
    "scrolling",
    "data",
    "table",
    "cell",
    "canvas"
  ],
  "author": "Glide",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/glideapps/glide-data-grid/issues"
  },
  "homepage": "https://grid.glideapps.com",
  "dependencies": {
    "@linaria/react": "^6.3.0",
    "canvas-hypertxt": "^1.0.3",
    "lodash": "^4.17.21",
    "marked": "^16.0.10",
    "react-number-format": "^5.4.4",
    "react-responsive-carousel": "^3.2.23"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {},
  "private": true
}
