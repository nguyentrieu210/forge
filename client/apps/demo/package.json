{
  "name": "@metaforge/demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "selfcheck": "esbuild src/selfcheck.ts --bundle --platform=node --format=cjs --jsx=automatic --outfile=.selfcheck.cjs && node .selfcheck.cjs",
    "e2e": "playwright test",
    "e2e:live": "playwright test --config playwright.live.config.ts",
    "smoke": "tsx src/smoke.ts",
    "roundtrip:live": "node roundtrip-live.mjs",
    "customize:live": "node customize-live.mjs",
    "serializers:live": "node serializers-live.mjs"
  },
  "dependencies": {
    "@metaforge/adapter-frappe": "workspace:*",
    "@metaforge/builder": "workspace:*",
    "@metaforge/controls": "workspace:*",
    "@metaforge/core": "workspace:*",
    "@metaforge/shell": "workspace:*",
    "@metaforge/ui": "workspace:*",
    "@metaforge/views": "workspace:*",
    "lucide-react": "^0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "0.25.12",
    "tailwindcss": "^4.0.0",
    "tsx": "4.19.2",
    "vite": "6.4.3"
  }
}
