{
  "name": "runtime",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:matrix-harness": "vite --config vite.matrix-e2e.config.ts",
    "typecheck": "pnpm --workspace-root --filter \"runtime^...\" run build && tsc -b",
    "build": "tsc -b && vite build",
    "build:matrix-harness": "vite build --config vite.matrix-e2e.config.ts",
    "preview:alumdoor-local": "vite preview --host 127.0.0.1 --port 5173 --strictPort"
  },
  "dependencies": {
    "@cloudforge/alumdoor-hr-payroll-contract": "workspace:*",
    "@hookform/resolvers": "^5.4.0",
    "@metaforge/adapter-frappe": "workspace:*",
    "@metaforge/controls": "workspace:*",
    "@metaforge/core": "workspace:*",
    "@metaforge/shell": "workspace:*",
    "@metaforge/ui": "workspace:*",
    "@metaforge/views": "workspace:*",
    "jsqr": "1.4.0",
    "lucide-react": "^0.460.0",
    "qrcode-generator": "2.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.82.0",
    "react-router-dom": "7.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "5.6.3",
    "vite": "6.4.3"
  }
