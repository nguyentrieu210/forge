{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["vite/client", "react", "react-dom"],
    "paths": {
      "@metaforge/adapter-frappe": ["../kho/node_modules/@metaforge/adapter-frappe"],
      "@metaforge/core": ["../kho/node_modules/@metaforge/core"],
      "@metaforge/shell": ["../kho/node_modules/@metaforge/shell"],
      "@metaforge/ui": ["../kho/node_modules/@metaforge/ui"]
    }
  },
  "include": ["src/**/*"]
}
