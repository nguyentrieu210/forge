{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudforge-query-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-23",
  "vars": {
    "TENANT_ID": "demo",
    "AUTH_MODE": "production"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "cloudforge-demo", "database_id": "54f6fcc3-8767-429c-8ecd-5e0c71543d33", "migrations_dir": "../../migrations/tenant" }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "queues": {
    "producers": [{ "binding": "REPORT_QUEUE", "queue": "cloudforge-prepared-reports" }],
    "consumers": [{ "queue": "cloudforge-prepared-reports", "max_batch_size": 5, "max_batch_timeout": 5, "max_retries": 3 }]
  }
}
