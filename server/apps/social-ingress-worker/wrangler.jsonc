{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudforge-social-ingress",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "d1_databases": [{
    "binding": "CONTROL_DB",
    "database_name": "cloudforge-control",
    "database_id": "65fa6833-c1da-4924-81cd-ab9a44d98c38",
    "migrations_dir": "../../migrations/control"
  }],
  "kv_namespaces": [{ "binding": "ROUTES", "id": "b4607d01c54042dcbc3d6cb3e1ad2da4" }],
  "queues": {
    "producers": [{ "binding": "SOCIAL_EVENTS", "queue": "cloudforge-social-events" }],
    "consumers": [{
      "queue": "cloudforge-social-events",
      "max_batch_size": 10,
      "max_batch_timeout": 2,
      "max_retries": 8,
      "dead_letter_queue": "cloudforge-social-events-dlq"
    }]
  },
  "dispatch_namespaces": [{ "binding": "DISPATCHER", "namespace": "cloudforge-production", "remote": true }]
}
