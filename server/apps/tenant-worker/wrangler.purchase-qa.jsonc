{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cloudforge-tenant-purchase-qa",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "TENANT_ID": "demo",
    "AUTH_MODE": "production",
    "PUBLIC_ORIGIN": "http://127.0.0.1:8801",
    "INTERNAL_AUTH_KEY_ID": "purchase-qa-k1"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudforge-demo",
      "database_id": "54f6fcc3-8767-429c-8ecd-5e0c71543d33",
      "migrations_dir": "../../migrations/tenant"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "AGGREGATES", "class_name": "AggregateCoordinator" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AggregateCoordinator"] }
  ],
  "services": [
    {
      "binding": "DISPATCHER",
      "service": "cloudforge-app-alumdoor"
    }
  ]
}
