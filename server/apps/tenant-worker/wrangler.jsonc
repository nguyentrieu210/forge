{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudforge-tenant-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "placement": { "mode": "smart" },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "vars": {
    "TENANT_ID": "demo",
    "AUTH_MODE": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudforge-demo",
      "database_id": "54f6fcc3-8767-429c-8ecd-5e0c71543d33",
      "migrations_dir": "../../migrations/tenant"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "AGGREGATES", "class_name": "AggregateCoordinator" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AggregateCoordinator"] }
  ],
  "triggers": { "crons": ["*/1 * * * *"] },
  "queues": {
    "producers": [
      { "binding": "OUTBOX_QUEUE", "queue": "cloudforge-outbox" }
    ]
  },
  // Attachments and product photographs. One bucket for every tenant, with the tenant id
  // as the first path segment of each key: a per-tenant bucket would mean provisioning a
  // customer could fail on a bucket-count limit long before anything about their data
  // was a problem. Reads are still scoped by the `files` table, which is per tenant.
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "cloudforge-files" }
  ],
  "services": [
    { "binding": "SOCIAL_INGRESS", "service": "cloudforge-social-ingress" }
  ]
}
