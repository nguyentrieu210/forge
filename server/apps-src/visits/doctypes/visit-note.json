{
  "name": "Visit Note",
  "module": "Visits",
  "is_submittable": true,
  "autoname": "VN-.YYYY.-#####",
  "title_field": "subject",
  "search_fields": ["subject"],
  "track_seen": true,
  "fields": [
    { "fieldname": "subject", "label": "Chủ đề", "fieldtype": "Data", "required": true, "in_list_view": true },
    { "fieldname": "category", "label": "Phân loại", "fieldtype": "Link", "options": "Visit Category", "in_standard_filter": true },
    { "fieldname": "is_followup", "label": "Cần theo dõi", "fieldtype": "Check" },
    { "fieldname": "followup_note", "label": "Ghi chú theo dõi", "fieldtype": "Data", "mandatory_depends_on": "eval:doc.is_followup == 1" },
    { "fieldname": "body", "label": "Nội dung", "fieldtype": "Text" }
  ],
  "permissions": [
    { "role": "Visit User", "read": true, "write": true, "create": true, "submit": true },
    { "role": "Visit Manager", "read": true, "write": true, "create": true, "submit": true, "cancel": true, "amend": true, "share": true, "report": true, "export": true }
  ],
  "revision": 1
}
