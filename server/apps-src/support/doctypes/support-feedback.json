{
  "name": "Support Feedback",
  "module": "Support",
  "autoname": "CSAT-.YYYY.-#####",
  "title_field": "ticket",
  "search_fields": ["ticket", "customer"],
  "sort_field": "submitted_at",
  "sort_order": "DESC",
  "track_seen": true,
  "fields": [
    { "fieldname": "ticket", "label": "Phiếu hỗ trợ", "fieldtype": "Link", "options": "Support Ticket", "required": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "customer", "label": "Khách hàng", "fieldtype": "Link", "options": "Customer", "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "rating", "label": "Điểm hài lòng", "fieldtype": "Select", "options": "1\n2\n3\n4\n5", "required": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "comment", "label": "Nhận xét", "fieldtype": "Text" },
    { "fieldname": "submitted_at", "label": "Thời điểm", "fieldtype": "Datetime", "default": "Now", "required": true, "in_list_view": true },
    { "fieldname": "followup_required", "label": "Cần chăm sóc lại", "fieldtype": "Check", "default": 0, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "followup_note", "label": "Ghi chú chăm sóc lại", "fieldtype": "Text", "mandatory_depends_on": "eval:doc.followup_required == 1" }
  ],
  "permissions": [
    { "role": "Support User", "read": true, "create": true, "report": true },
    { "role": "Support Manager", "read": true, "write": true, "create": true, "delete": true, "report": true, "export": true },
    { "role": "System Manager", "read": true, "write": true, "create": true, "delete": true, "report": true, "export": true }
  ],
  "revision": 1
}
