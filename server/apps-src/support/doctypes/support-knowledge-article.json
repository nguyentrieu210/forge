{
  "name": "Support Knowledge Article",
  "module": "Support",
  "autoname": "KB-.YYYY.-#####",
  "title_field": "title",
  "search_fields": ["title", "category", "keywords"],
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_seen": true,
  "fields": [
    { "fieldname": "title", "label": "Tiêu đề", "fieldtype": "Data", "required": true, "in_list_view": true, "search_index": true },
    { "fieldname": "category", "label": "Danh mục", "fieldtype": "Data", "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "keywords", "label": "Từ khóa", "fieldtype": "Data", "search_index": true },
    { "fieldname": "summary", "label": "Tóm tắt", "fieldtype": "Text" },
    { "fieldname": "content", "label": "Nội dung", "fieldtype": "Text", "required": true },
    { "fieldname": "source_reference", "label": "Nguồn / tham chiếu", "fieldtype": "Data" },
    { "fieldname": "is_published", "label": "Đã xuất bản", "fieldtype": "Check", "default": 0, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "published_at", "label": "Thời điểm xuất bản", "fieldtype": "Datetime", "mandatory_depends_on": "eval:doc.is_published == 1" },
    { "fieldname": "reviewed_by", "label": "Người duyệt nội dung", "fieldtype": "Link", "options": "User" }
  ],
  "permissions": [
    { "role": "Support User", "read": true },
    { "role": "Support Manager", "read": true, "write": true, "create": true, "delete": true, "report": true, "export": true },
    { "role": "System Manager", "read": true, "write": true, "create": true, "delete": true, "report": true, "export": true }
  ],
  "revision": 1
}
