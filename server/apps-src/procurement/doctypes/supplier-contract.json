{
  "name": "Supplier Contract",
  "module": "Buying",
  "is_submittable": true,
  "autoname": "SUP-CON-.YYYY.-#####",
  "title_field": "contract_reference",
  "sort_field": "valid_from",
  "sort_order": "DESC",
  "track_changes": true,
  "fields": [
    { "fieldname": "supplier", "label": "Nhà cung cấp", "fieldtype": "Link", "options": "Supplier", "required": true, "set_only_once": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "company", "label": "Công ty", "fieldtype": "Link", "options": "Company", "required": true, "set_only_once": true, "in_standard_filter": true },
    { "fieldname": "contract_reference", "label": "Số / mã hợp đồng", "fieldtype": "Data", "required": true, "set_only_once": true, "in_list_view": true, "search_index": true },
    { "fieldname": "currency", "label": "Tiền tệ", "fieldtype": "Link", "options": "Currency", "required": true, "in_list_view": true },
    { "fieldname": "valid_from", "label": "Hiệu lực từ", "fieldtype": "Date", "required": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "valid_until", "label": "Hiệu lực đến", "fieldtype": "Date", "required": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "maximum_qty", "label": "Trần số lượng", "fieldtype": "Float", "non_negative": true },
    { "fieldname": "quantity_uom", "label": "ĐVT trần số lượng", "fieldtype": "Link", "options": "UOM", "depends_on": "eval:doc.maximum_qty > 0" },
    { "fieldname": "maximum_value", "label": "Trần giá trị", "fieldtype": "Currency", "non_negative": true },
    { "fieldname": "notes", "label": "Điều khoản / ghi chú", "fieldtype": "Text Editor" },
    { "fieldname": "approved_by", "label": "Người duyệt", "fieldtype": "Link", "options": "User", "read_only": true, "in_list_view": true },
    { "fieldname": "approved_on", "label": "Thời điểm duyệt", "fieldtype": "Datetime", "read_only": true }
  ],
  "permissions": [
    { "role": "Purchase User", "read": true, "write": true, "create": true, "report": true },
    { "role": "Purchase Manager", "read": true, "write": true, "create": true, "submit": true, "cancel": true, "amend": true, "print": true, "report": true, "export": true, "share": true },
    { "role": "System Manager", "read": true, "write": true, "create": true, "submit": true, "cancel": true, "amend": true, "print": true, "report": true, "export": true, "share": true }
  ],
  "revision": 1
}
