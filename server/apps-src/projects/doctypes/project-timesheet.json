{
  "name": "Project Timesheet",
  "module": "Projects",
  "is_submittable": true,
  "autoname": "PTS-.YYYY.-#####",
  "title_field": "employee",
  "search_fields": ["employee", "project"],
  "sort_field": "period_start",
  "sort_order": "DESC",
  "track_seen": true,
  "fields": [
    { "fieldname": "employee", "label": "Nhân viên", "fieldtype": "Link", "options": "Employee", "required": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "project", "label": "Dự án", "fieldtype": "Link", "options": "Project", "required": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "period_start", "label": "Từ ngày", "fieldtype": "Date", "required": true, "in_list_view": true },
    { "fieldname": "period_end", "label": "Đến ngày", "fieldtype": "Date", "required": true, "in_list_view": true },
    { "fieldname": "details", "label": "Chi tiết thời gian", "fieldtype": "Table", "options": "Project Timesheet Detail", "required": true },
    { "fieldname": "employee_note", "label": "Ghi chú người lập", "fieldtype": "Text" },
    { "fieldname": "approval_note", "label": "Ghi chú phê duyệt", "fieldtype": "Text" },
    { "fieldname": "rejection_reason", "label": "Lý do trả lại", "fieldtype": "Text", "mandatory_depends_on": "eval:doc.workflow_state == 'Trả lại'" },
    { "fieldname": "cancel_reason", "label": "Lý do hủy", "fieldtype": "Text", "mandatory_depends_on": "eval:doc.workflow_state == 'Hủy'" },
    { "fieldname": "workflow_state", "label": "Trạng thái", "fieldtype": "Data", "read_only": true, "in_list_view": true, "in_standard_filter": true }
  ],
  "viewPolicy": {
    "kanban": { "enabled": true, "stageField": "workflow_state", "reasonRequiredOn": ["backward", "cancel"] },
    "mobile": { "compactFields": ["employee", "project", "period_start", "period_end", "workflow_state"] }
  },
  "permissions": [
    { "role": "Project User", "read": true, "write": true, "create": true, "print": true, "report": true },
    { "role": "Project Manager", "read": true, "write": true, "create": true, "submit": true, "cancel": true, "amend": true, "print": true, "report": true, "export": true, "share": true },
    { "role": "System Manager", "read": true, "write": true, "create": true, "submit": true, "cancel": true, "amend": true, "print": true, "report": true, "export": true, "share": true }
  ],
  "revision": 1
}
