{
  "name": "TT99 Financial Statement Template",
  "module": "Accounts",
  "is_submittable": true,
  "autoname": "TT99-BCTC-.YYYY.-#####",
  "title_field": "label",
  "sort_field": "effective_from",
  "sort_order": "DESC",
  "track_changes": true,
  "fields": [
    { "fieldname": "statement_code", "label": "Mã báo cáo", "fieldtype": "Data", "required": true, "in_list_view": true, "search_index": true },
    { "fieldname": "label", "label": "Tên báo cáo", "fieldtype": "Data", "required": true, "in_list_view": true, "search_index": true },
    { "fieldname": "company", "label": "Công ty (để trống = mẫu chuẩn)", "fieldtype": "Link", "options": "Company", "in_standard_filter": true },
    { "fieldname": "legal_rule", "label": "Căn cứ pháp lý", "fieldtype": "Link", "options": "VN Legal Rule", "required": true },
    { "fieldname": "statement_type", "label": "Loại BCTC", "fieldtype": "Select", "options": "Balance Sheet\nIncome Statement\nCash Flow\nNotes\nOther", "required": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "template_version", "label": "Phiên bản mẫu", "fieldtype": "Data", "required": true, "in_list_view": true },
    { "fieldname": "lines_json", "label": "Chỉ tiêu và công thức", "fieldtype": "Code", "required": true, "default": "[]" },
    { "fieldname": "comparative_policy", "label": "Chính sách số so sánh", "fieldtype": "Select", "options": "PriorPeriod\nPriorYear\nNone", "required": true, "default": "PriorYear" },
    { "fieldname": "currency_policy", "label": "Đơn vị tiền", "fieldtype": "Select", "options": "Company\nPresentation", "required": true, "default": "Company" },
    { "fieldname": "rounding_digits", "label": "Số chữ số làm tròn", "fieldtype": "Int", "required": true, "default": 0 },
    { "fieldname": "effective_from", "label": "Hiệu lực từ", "fieldtype": "Date", "required": true, "in_list_view": true },
    { "fieldname": "effective_to", "label": "Hiệu lực đến", "fieldtype": "Date" },
    { "fieldname": "test_evidence_json", "label": "Bằng chứng kiểm thử", "fieldtype": "Code", "required": true, "default": "{}" },
    { "fieldname": "approved_by", "label": "Người phê duyệt", "fieldtype": "Data", "read_only": true },
    { "fieldname": "approved_at", "label": "Thời điểm phê duyệt", "fieldtype": "Datetime", "read_only": true },
    { "fieldname": "workflow_state", "label": "Trạng thái", "fieldtype": "Data", "read_only": true, "in_list_view": true, "in_standard_filter": true }
  ],
  "permissions": [
    { "role": "Accounts User", "read": true, "report": true },
    { "role": "General Accountant", "read": true, "write": true, "create": true, "report": true, "export": true },
    { "role": "Chief Accountant", "read": true, "write": true, "create": true, "submit": true, "report": true, "export": true, "share": true },
    { "role": "Accounts Manager", "read": true, "write": true, "create": true, "submit": true, "report": true, "export": true, "share": true },
    { "role": "Internal Auditor", "read": true, "report": true, "export": true },
    { "role": "System Manager", "read": true, "write": true, "create": true, "submit": true, "report": true, "export": true, "share": true }
  ],
  "revision": 2
}
