{
  "name": "TT99 Account Map",
  "module": "Accounts",
  "is_submittable": true,
  "autoname": "MAP-TT99-.YYYY.-#####",
  "title_field": "source_account",
  "sort_field": "effective_from",
  "sort_order": "DESC",
  "track_changes": true,
  "fields": [
    { "fieldname": "company", "label": "Công ty", "fieldtype": "Link", "options": "Company", "required": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "source_account", "label": "Tài khoản nguồn/lịch sử", "fieldtype": "Link", "options": "Account", "required": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "target_account", "label": "Tài khoản TT99 đích", "fieldtype": "Link", "options": "Account", "required": true, "in_list_view": true },
    { "fieldname": "source_regime", "label": "Chế độ nguồn", "fieldtype": "Select", "options": "TT200-legacy\nTT133\nTT132-legacy\nKhác", "required": true },
    { "fieldname": "target_regime", "label": "Chế độ đích", "fieldtype": "Select", "options": "TT99", "required": true, "default": "TT99" },
    { "fieldname": "effective_from", "label": "Hiệu lực từ", "fieldtype": "Date", "required": true, "in_list_view": true },
    { "fieldname": "effective_to", "label": "Hiệu lực đến", "fieldtype": "Date" },
    { "fieldname": "legal_rule", "label": "Quy tắc pháp lý", "fieldtype": "Link", "options": "VN Legal Rule", "required": true },
    { "fieldname": "mapping_reason", "label": "Cơ sở chuyển đổi", "fieldtype": "Small Text", "required": true },
    { "fieldname": "workflow_state", "label": "Trạng thái", "fieldtype": "Data", "read_only": true, "in_list_view": true, "in_standard_filter": true }
  ],
  "permissions": [
    { "role": "Accounts User", "read": true, "report": true },
    { "role": "General Accountant", "read": true, "write": true, "create": true, "report": true, "export": true },
    { "role": "Chief Accountant", "read": true, "write": true, "create": true, "submit": true, "cancel": true, "amend": true, "report": true, "export": true, "share": true },
    { "role": "Accounts Manager", "read": true, "write": true, "create": true, "submit": true, "cancel": true, "amend": true, "report": true, "export": true, "share": true },
    { "role": "Internal Auditor", "read": true, "report": true, "export": true },
    { "role": "System Manager", "read": true, "write": true, "create": true, "submit": true, "cancel": true, "amend": true, "report": true, "export": true, "share": true }
  ],
  "revision": 1
}
