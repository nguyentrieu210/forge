{
  "name": "VN Reconciliation Case",
  "module": "Accounts",
  "is_submittable": true,
  "autoname": "DSKT-.YYYY.-#####",
  "title_field": "exception_code",
  "sort_field": "detected_at",
  "sort_order": "DESC",
  "track_changes": true,
  "fields": [
    { "fieldname": "company", "label": "Công ty", "fieldtype": "Link", "options": "Company", "required": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "branch", "label": "Chi nhánh", "fieldtype": "Link", "options": "Branch", "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "kind", "label": "Loại đối soát", "fieldtype": "Select", "options": "AR\nAP\nBank\nSubledger\nPayroll\nTax\nInventory", "required": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "severity", "label": "Mức độ", "fieldtype": "Select", "options": "Critical\nHigh\nMedium\nLow", "required": true, "default": "High", "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "exception_code", "label": "Mã ngoại lệ", "fieldtype": "Data", "required": true, "in_list_view": true, "search_index": true },
    { "fieldname": "source_doctype", "label": "Loại chứng từ nguồn", "fieldtype": "Data", "required": true },
    { "fieldname": "source_document", "label": "Chứng từ nguồn", "fieldtype": "Data", "required": true },
    { "fieldname": "currency", "label": "Tiền tệ", "fieldtype": "Link", "options": "Currency", "required": true },
    { "fieldname": "expected_minor", "label": "Số kỳ vọng (đơn vị nhỏ nhất)", "fieldtype": "Int", "required": true },
    { "fieldname": "actual_minor", "label": "Số thực tế (đơn vị nhỏ nhất)", "fieldtype": "Int", "required": true },
    { "fieldname": "difference_minor", "label": "Chênh lệch (đơn vị nhỏ nhất)", "fieldtype": "Int", "required": true, "in_list_view": true },
    { "fieldname": "detected_at", "label": "Phát hiện lúc", "fieldtype": "Datetime", "required": true, "in_list_view": true },
    { "fieldname": "root_cause", "label": "Nguyên nhân gốc", "fieldtype": "Small Text" },
    { "fieldname": "resolution_doctype", "label": "Loại chứng từ xử lý", "fieldtype": "Data" },
    { "fieldname": "resolution_document", "label": "Chứng từ xử lý", "fieldtype": "Data" },
    { "fieldname": "workflow_state", "label": "Trạng thái", "fieldtype": "Data", "read_only": true, "in_list_view": true, "in_standard_filter": true }
  ],
  "permissions": [
    { "role": "Accounts User", "read": true, "report": true },
    { "role": "General Accountant", "read": true, "write": true, "create": true, "report": true, "export": true },
    { "role": "Chief Accountant", "read": true, "write": true, "create": true, "submit": true, "cancel": true, "amend": true, "report": true, "export": true, "share": true },
    { "role": "Accounts Manager", "read": true, "write": true, "create": true, "submit": true, "cancel": true, "amend": true, "report": true, "export": true, "share": true },
    { "role": "Internal Auditor", "read": true, "report": true, "export": true },
    { "role": "System Manager", "read": true, "write": true, "create": true, "submit": true, "cancel": true, "amend": true, "report": true, "export": true, "share": true }
  ],
  "revision": 1
}
