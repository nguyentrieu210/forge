{
  "id": "vn-accounting",
  "name": "Kế toán Việt Nam",
  "version": "1.5.0",
  "worker": "cloudforge-app-vn-accounting",
  "requires": [
    { "id": "hrm", "version": ">=1.3.0" }
  ],
  "externalDocTypes": [
    { "name": "Purchase Receipt", "kind": "transaction", "app": "erpnext" },
    { "name": "Stock Entry", "kind": "transaction", "app": "erpnext" },
    { "name": "E-Invoice Submission", "kind": "transaction", "app": "erpnext" }
  ],
  "validators": [
    { "doctype": "VN Tax Ruleset", "actions": ["submit"] }
  ],
  "actions": [
    {
      "name": "tax-evaluate",
      "label": "Tính thử ruleset thuế",
      "icon": "calculator",
      "group": "Thuế & tuân thủ",
      "description": "Chạy ruleset đã duyệt bằng fixed-point minor units. Không ghi sổ hay nộp tờ khai.",
      "fields": [
        { "fieldname": "ruleset", "label": "Ruleset", "fieldtype": "Link", "options": "VN Tax Ruleset", "required": true },
        { "fieldname": "company", "label": "Công ty", "fieldtype": "Link", "options": "Company", "required": true },
        { "fieldname": "effective_at", "label": "Ngày áp dụng", "fieldtype": "Date", "required": true },
        { "fieldname": "input_json", "label": "Đầu vào minor units (JSON)", "fieldtype": "Code", "required": true, "default": "{}" }
      ],
      "commit": { "method": "vn-accounting.tax.evaluate", "label": "Tính thử" },
      "permission_doctype": "VN Tax Ruleset",
      "permission_action": "read"
    }
  ],
  "nav": [
    { "key": "VN Accounting Policy", "label": "Chính sách kế toán", "kind": "doctype", "icon": "landmark", "group": "Thiết lập kế toán" },
