{
  "name": "CRM Lead",
  "module": "CRM",
  "autoname": "CRM-LEAD-.YYYY.-#####",
  "title_field": "lead_name",
  "track_changes": true,
  "fields": [
    { "fieldname": "company", "label": "Công ty", "fieldtype": "Link", "options": "Company", "required": true, "set_only_once": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "lead_name", "label": "Tên khách hàng tiềm năng", "fieldtype": "Data", "required": true, "in_list_view": true, "search_index": true },
    { "fieldname": "organization_name", "label": "Công ty / tổ chức", "fieldtype": "Data", "in_list_view": true, "search_index": true },
    { "fieldname": "status", "label": "Trạng thái", "fieldtype": "Select", "options": "New\nOpen\nQualified\nUnqualified\nConverted", "default": "New", "required": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "email_id", "label": "Email", "fieldtype": "Data", "in_list_view": true, "search_index": true },
    { "fieldname": "mobile_no", "label": "Điện thoại", "fieldtype": "Phone", "in_list_view": true, "search_index": true },
    { "fieldname": "lead_source", "label": "Nguồn khách hàng", "fieldtype": "Link", "options": "CRM Lead Source", "in_standard_filter": true },
    { "fieldname": "territory", "label": "Khu vực", "fieldtype": "Link", "options": "Territory", "in_standard_filter": true },
    { "fieldname": "sales_team", "label": "Nhóm bán hàng", "fieldtype": "Link", "options": "CRM Sales Team", "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "assigned_to", "label": "Phụ trách", "fieldtype": "Link", "options": "User", "in_standard_filter": true },
    { "fieldname": "converted_customer", "label": "Khách hàng ERP đã chuyển đổi", "fieldtype": "Link", "options": "Customer", "mandatory_depends_on": "eval:doc.status=='Converted'" },
    { "fieldname": "converted_deal", "label": "Deal đã chuyển đổi", "fieldtype": "Link", "options": "CRM Deal", "mandatory_depends_on": "eval:doc.status=='Converted'" },
    { "fieldname": "notes", "label": "Ghi chú", "fieldtype": "Text Editor" }
  ],
  "permissions": [
    { "role": "Sales User", "read": true, "write": true, "create": true, "print": true, "report": true },
    { "role": "Sales Manager", "read": true, "write": true, "create": true, "delete": true, "print": true, "report": true, "export": true, "share": true },
    { "role": "System Manager", "read": true, "write": true, "create": true, "delete": true, "print": true, "report": true, "export": true, "share": true }
  ],
  "revision": 4
}
