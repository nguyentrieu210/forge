  "permissions": [
    { "role": "Sales User", "read": true, "create": true, "report": true },
    { "role": "Sales Manager", "read": true, "create": true, "report": true, "export": true },
    { "role": "System Manager", "read": true, "create": true, "report": true, "export": true }
