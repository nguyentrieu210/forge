{
  "name": "CRM Commission Rule",
  "module": "CRM",
  "autoname": "CRM-COMM-RULE-.YYYY.-#####",
  "title_field": "rule_name",
  "track_changes": true,
  "fields": [
    { "fieldname": "company", "label": "Công ty", "fieldtype": "Link", "options": "Company", "required": true, "set_only_once": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "rule_name", "label": "Tên chính sách", "fieldtype": "Data", "required": true, "in_list_view": true, "search_index": true },
    { "fieldname": "rate", "label": "Tỷ lệ hoa hồng (%)", "fieldtype": "Percent", "required": true, "in_list_view": true },
    { "fieldname": "effective_from", "label": "Hiệu lực từ", "fieldtype": "Date", "required": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "effective_to", "label": "Hiệu lực đến", "fieldtype": "Date", "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "status", "label": "Trạng thái", "fieldtype": "Select", "options": "Active\nInactive", "default": "Active", "required": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "notes", "label": "Ghi chú", "fieldtype": "Text Editor" }
  ],
  "permissions": [
    { "role": "Sales Manager", "read": true, "write": true, "create": true, "delete": true, "print": true, "report": true, "export": true, "share": true },
    { "role": "System Manager", "read": true, "write": true, "create": true, "delete": true, "print": true, "report": true, "export": true, "share": true }
  ],
  "revision": 1
}
