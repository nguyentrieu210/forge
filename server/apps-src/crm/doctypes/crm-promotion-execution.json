{
  "name": "CRM Promotion Execution",
  "module": "CRM",
  "autoname": "CRM-PROMO-.YYYY.-#####",
  "track_changes": true,
  "fields": [
    { "fieldname": "company", "label": "Công ty", "fieldtype": "Link", "options": "Company", "required": true, "set_only_once": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "campaign", "label": "Chiến dịch", "fieldtype": "Link", "options": "CRM Campaign", "required": true, "set_only_once": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "partner", "label": "Đối tác", "fieldtype": "Link", "options": "CRM Channel Partner", "required": true, "set_only_once": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "salesperson", "label": "Nhân viên thực hiện", "fieldtype": "Link", "options": "User", "required": true, "set_only_once": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "planned_date", "label": "Ngày dự kiến", "fieldtype": "Date", "required": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "status", "label": "Trạng thái", "fieldtype": "Select", "options": "Planned\nExecuted\nCancelled", "default": "Planned", "required": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "executed_at", "label": "Thực hiện lúc", "fieldtype": "Datetime", "read_only": true, "depends_on": "eval:doc.status=='Executed'", "in_list_view": true },
    { "fieldname": "field_check_in", "label": "Bằng chứng check-in", "fieldtype": "Link", "options": "CRM Field Check-In", "mandatory_depends_on": "eval:doc.status=='Executed'", "depends_on": "eval:doc.status=='Executed'", "in_list_view": true },
    { "fieldname": "notes", "label": "Ghi chú", "fieldtype": "Small Text" }
  ],
  "permissions": [
    { "role": "Sales User", "read": true, "write": true, "report": true },
    { "role": "Sales Manager", "read": true, "write": true, "create": true, "report": true, "export": true, "share": true },
    { "role": "System Manager", "read": true, "write": true, "create": true, "report": true, "export": true, "share": true }
  ],
  "revision": 1
}
