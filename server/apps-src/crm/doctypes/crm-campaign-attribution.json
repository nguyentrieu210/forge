    { "fieldname": "campaign", "label": "Chiến dịch", "fieldtype": "Link", "options": "CRM Campaign", "required": true, "set_only_once": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "deal", "label": "Deal", "fieldtype": "Link", "options": "CRM Deal", "required": true, "set_only_once": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "model", "label": "Mô hình attribution", "fieldtype": "Select", "options": "First Touch\nLast Touch\nInfluenced", "required": true, "set_only_once": true, "in_list_view": true },
    { "fieldname": "attribution_percent", "label": "Tỷ lệ attribution (%)", "fieldtype": "Percent", "required": true, "set_only_once": true, "in_list_view": true },
