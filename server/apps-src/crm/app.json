    { "key": "crm-lead-source-performance", "label": "Hiệu quả nguồn lead", "kind": "route", "route": "/report/crm-lead-source-performance", "icon": "chart-bar-big", "group": "Phân tích", "required_roles": ["Sales User", "Sales Manager", "System Manager"] },
