    { "key": "CRM Marketing List", "label": "Danh sách marketing", "kind": "doctype", "icon": "list-filter", "group": "Marketing" },
    { "key": "CRM Marketing List Member", "label": "Thành viên marketing", "kind": "doctype", "icon": "users-round", "group": "Marketing" },
    { "key": "CRM Segment", "label": "Phân khúc", "kind": "doctype", "icon": "scan-search", "group": "Marketing" },
