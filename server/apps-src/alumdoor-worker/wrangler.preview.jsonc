{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cloudforge-alumdoor-preview-app",
  "main": "src/entry.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 }
  },
  "services": [
    { "binding": "PLATFORM", "service": "cloudforge-alumdoor-preview-tenant" }
  ],
  "ai": { "binding": "AI" }
}
