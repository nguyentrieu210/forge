{
  "name": "VN Payroll Rule",
  "module": "Payroll",
  "autoname": "field:rule_code",
  "title_field": "rule_name",
  "track_changes": true,
  "fields": [
    { "fieldname": "rule_code", "label": "Mã quy tắc", "fieldtype": "Data", "required": true, "unique": true, "in_list_view": true },
    { "fieldname": "rule_name", "label": "Tên bộ quy tắc", "fieldtype": "Data", "required": true, "in_list_view": true },
    { "fieldname": "effective_from", "label": "Hiệu lực từ", "fieldtype": "Date", "required": true, "in_list_view": true },
    { "fieldname": "effective_to", "label": "Hiệu lực đến", "fieldtype": "Date" },
    { "fieldname": "legal_document_no", "label": "Số văn bản pháp lý", "fieldtype": "Data", "required": true },
    { "fieldname": "source_url", "label": "Nguồn chính thức", "fieldtype": "Data", "required": true },
    { "fieldname": "formula_json", "label": "Công thức phiên bản hóa", "fieldtype": "Code", "required": true },
    { "fieldname": "approved_by", "label": "Người phê duyệt", "fieldtype": "Data", "required": true },
    { "fieldname": "approved_at", "label": "Thời điểm phê duyệt", "fieldtype": "Datetime", "required": true },
    { "fieldname": "disabled", "label": "Ngừng áp dụng", "fieldtype": "Check", "default": 0 }
  ],
  "permissions": [
    { "role": "Payroll User", "read": true, "report": true },
    { "role": "Payroll Manager", "read": true, "write": true, "create": true, "report": true, "export": true },
    { "role": "Accounts Manager", "read": true, "report": true },
    { "role": "System Manager", "read": true, "write": true, "create": true, "report": true, "export": true }
  ],
  "revision": 1
}
