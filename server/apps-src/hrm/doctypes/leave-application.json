    { "fieldname": "branch", "label": "Chi nhánh", "fieldtype": "Link", "options": "Branch", "required": true, "in_standard_filter": true },
    { "fieldname": "department", "label": "Phòng ban", "fieldtype": "Link", "options": "Department", "required": true, "in_standard_filter": true },
    { "fieldname": "employee", "label": "Nhân viên", "fieldtype": "Link", "options": "Employee", "required": true, "in_list_view": true, "in_standard_filter": true, "search_index": true },
    { "fieldname": "leave_type", "label": "Loại nghỉ", "fieldtype": "Link", "options": "Leave Type", "required": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "from_date", "label": "Từ ngày", "fieldtype": "Date", "required": true, "in_list_view": true },
    { "fieldname": "to_date", "label": "Đến ngày", "fieldtype": "Date", "required": true, "in_list_view": true },
    { "fieldname": "half_day", "label": "Nghỉ nửa ngày", "fieldtype": "Check" },
    { "fieldname": "half_day_date", "label": "Ngày nghỉ nửa buổi", "fieldtype": "Date", "mandatory_depends_on": "eval:doc.half_day == 1" },
