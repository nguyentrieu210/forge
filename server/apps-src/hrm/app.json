  "reports": [
    {
      "name":"hr-recruitment-pipeline",
      "label":"Pipeline tuyển dụng",
      "doctype":"Job Applicant",
      "columns":[
        {"field":"applicant_status","label":"Trạng thái","type":"Data"},
        {"field":"name","label":"Số ứng viên","type":"Int","aggregate":"count"}
      ],
      "group_by":"applicant_status",
      "order_by":{"column":"name","direction":"desc"},
      "filters":["job_opening","applicant_status","source"],
      "limit":100
    },
    {
      "name":"hr-leave-usage",
      "label":"Sử dụng ngày phép",
      "doctype":"Leave Application",
      "columns":[
        {"field":"leave_type","label":"Loại nghỉ","type":"Link","options":"Leave Type"},
        {"field":"total_days","label":"Tổng ngày","type":"Float","aggregate":"sum"}
      ],
      "group_by":"leave_type",
      "order_by":{"column":"total_days","direction":"desc"},
      "filters":["company","branch","department","employee","leave_type","from_date","to_date","workflow_state"],
      "limit":100
    },
    {
      "name":"hr-attendance-status",
      "label":"Tình trạng chấm công",
      "doctype":"Attendance",
      "columns":[
        {"field":"attendance_status","label":"Trạng thái","type":"Data"},
        {"field":"name","label":"Số ngày","type":"Int","aggregate":"count"}
      ],
      "group_by":"attendance_status",
      "order_by":{"column":"name","direction":"desc"},
      "filters":["company","branch","department","employee","attendance_date","attendance_status","late_entry","early_exit","source"],
      "limit":100
    },
    {
      "name":"hr-overtime-by-employee",
      "label":"Tăng ca theo nhân viên",
      "doctype":"Overtime Request",
      "columns":[
        {"field":"employee","label":"Nhân viên","type":"Link","options":"Employee"},
        {"field":"approved_minutes","label":"Phút tăng ca duyệt","type":"Int","aggregate":"sum"}
      ],
      "group_by":"employee",
      "order_by":{"column":"approved_minutes","direction":"desc"},
      "filters":["company","branch","employee","overtime_date","workflow_state"],
      "limit":100
    },
    {
      "name":"hr-advance-by-employee",
      "label":"Tạm ứng theo nhân viên",
      "doctype":"Employee Advance",
      "columns":[
        {"field":"employee","label":"Nhân viên","type":"Link","options":"Employee"},
        {"field":"advance_amount","label":"Tổng tạm ứng","type":"Currency","aggregate":"sum"}
      ],
      "group_by":"employee",
      "order_by":{"column":"advance_amount","direction":"desc"},
      "filters":["company","branch","employee","posting_date","workflow_state"],
      "limit":100
    }
  ],
  "screens": [
    {
      "name":"hr-self-service",
      "label":"Tự phục vụ nhân viên",
      "description":"Các yêu cầu và hồ sơ cá nhân trong phạm vi chính người dùng.",
      "icon":"user-round-cog",
      "group":"Tự phục vụ",
      "permission_doctype":"Leave Application",
      "mode":"desk",
      "columns":2,
      "blocks":[
        {"id":"leave","label":"Đơn nghỉ phép của tôi","type":"list","doctype":"Leave Application","fields":["name","from_date","to_date","total_days","workflow_state"],"order_by":"from_date desc","limit":10,"empty_text":"Chưa có đơn nghỉ phép."},
        {"id":"attendance-request","label":"Điều chỉnh công của tôi","type":"list","doctype":"Attendance Request","fields":["name","from_date","to_date","request_type","workflow_state"],"order_by":"from_date desc","limit":10,"empty_text":"Chưa có yêu cầu điều chỉnh."},
        {"id":"overtime","label":"Tăng ca của tôi","type":"list","doctype":"Overtime Request","fields":["name","overtime_date","approved_minutes","workflow_state"],"order_by":"overtime_date desc","limit":10,"empty_text":"Chưa có đăng ký tăng ca."},
        {"id":"advance","label":"Tạm ứng của tôi","type":"list","doctype":"Employee Advance","fields":["name","posting_date","purpose","currency","workflow_state"],"order_by":"posting_date desc","limit":10,"empty_text":"Chưa có đề nghị tạm ứng."},
        {"id":"goal","label":"Mục tiêu của tôi","type":"list","doctype":"Goal","fields":["name","goal_title","progress"],"order_by":"modified desc","limit":10,"empty_text":"Chưa có mục tiêu."},
        {"id":"appraisal","label":"Đánh giá của tôi","type":"list","doctype":"Appraisal","fields":["name","from_date","to_date","workflow_state"],"order_by":"from_date desc","limit":10,"empty_text":"Chưa có kỳ đánh giá."},
        {"id":"checkin","label":"Check-in gần đây","type":"list","doctype":"Employee Checkin","fields":["name","time","log_type","source"],"order_by":"time desc","limit":10,"empty_text":"Chưa có check-in cá nhân."}
      ]
    }
  ],
  "hooks": [],
  "client": {"brand":"blue","domain":"hr","home":{"route":"/app/Employee","doctype":"Employee"},"dimensions":["company","branch","fiscal_year"],"catalog_mode":"hybrid"}
