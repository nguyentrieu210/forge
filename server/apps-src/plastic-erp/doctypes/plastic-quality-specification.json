{
  "name": "Plastic Quality Specification",
  "module": "Plastic ERP",
  "is_submittable": true,
  "autoname": "PQS-.YYYY.-#####",
  "title_field": "spec_name",
  "search_fields": ["spec_name", "item"],
  "sort_field": "effective_from",
  "sort_order": "DESC",
  "fields": [
    { "fieldname": "spec_name", "label": "Tên tiêu chuẩn", "fieldtype": "Data", "required": true, "in_list_view": true, "search_index": true },
    { "fieldname": "company", "label": "Công ty", "fieldtype": "Link", "options": "Company", "required": true, "in_standard_filter": true },
    { "fieldname": "item", "label": "Mặt hàng", "fieldtype": "Link", "options": "Item", "required": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "revision_no", "label": "Revision", "fieldtype": "Int", "required": true, "default": 1, "in_list_view": true },
    { "fieldname": "effective_from", "label": "Hiệu lực từ", "fieldtype": "Date", "required": true, "in_list_view": true },
    { "fieldname": "effective_to", "label": "Hiệu lực đến", "fieldtype": "Date" },
    { "fieldname": "incoming_required", "label": "QC đầu vào", "fieldtype": "Check" },
    { "fieldname": "first_piece_required", "label": "QC mẫu đầu", "fieldtype": "Check", "default": 1 },
    { "fieldname": "in_process_required", "label": "QC trong quá trình", "fieldtype": "Check", "default": 1 },
    { "fieldname": "final_required", "label": "QC thành phẩm", "fieldtype": "Check", "default": 1 },
    { "fieldname": "coa_required", "label": "Xuất CoA", "fieldtype": "Check" },
    { "fieldname": "characteristics", "label": "Chỉ tiêu kiểm", "fieldtype": "Table", "options": "Plastic QC Characteristic", "required": true },
    { "fieldname": "approval_state", "label": "Trạng thái duyệt", "fieldtype": "Data", "read_only": true, "in_list_view": true, "in_standard_filter": true }
  ],
  "permissions": [
    { "role": "Plastic QC User", "read": true, "write": true, "create": true, "print": true, "report": true },
    { "role": "Plastic QC Manager", "read": true, "write": true, "create": true, "submit": true, "cancel": true, "amend": true, "print": true, "report": true, "export": true },
    { "role": "Plastic Engineering User", "read": true, "report": true },
    { "role": "Plastic Production Manager", "read": true, "report": true },
    { "role": "System Manager", "read": true, "write": true, "create": true, "submit": true, "cancel": true, "amend": true, "print": true, "report": true, "export": true, "share": true }
  ],
  "revision": 1
}
