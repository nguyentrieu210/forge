{
  "name": "Plastic Process Profile",
  "module": "Plastic ERP",
  "autoname": "PROC-.####",
  "title_field": "process_name",
  "search_fields": ["process_name", "process_type"],
  "sort_field": "process_name",
  "sort_order": "ASC",
  "fields": [
    { "fieldname": "process_name", "label": "Tên công nghệ", "fieldtype": "Data", "required": true, "unique": true, "in_list_view": true, "search_index": true },
    { "fieldname": "process_type", "label": "Loại công nghệ", "fieldtype": "Select", "options": "Injection\nExtrusion\nBlow Molding\nFilm\nCompounding\nPelletizing\nOther", "required": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "production_uom", "label": "ĐVT sản xuất", "fieldtype": "Link", "options": "UOM", "required": true, "in_list_view": true },
    { "fieldname": "uses_tool", "label": "Dùng khuôn / đầu đùn", "fieldtype": "Check", "default": 1 },
    { "fieldname": "uses_drying", "label": "Có sấy nguyên liệu", "fieldtype": "Check" },
    { "fieldname": "uses_mixing", "label": "Có phối liệu", "fieldtype": "Check", "default": 1 },
    { "fieldname": "supports_regrind", "label": "Cho phép hạt nghiền", "fieldtype": "Check", "default": 1 },
    { "fieldname": "default_scrap_pct", "label": "Phế chuẩn %", "fieldtype": "Float" },
    { "fieldname": "target_oee_pct", "label": "OEE mục tiêu %", "fieldtype": "Float" },
    { "fieldname": "active", "label": "Đang dùng", "fieldtype": "Check", "default": 1, "in_list_view": true, "in_standard_filter": true }
  ],
  "permissions": [
    { "role": "Plastic Engineering User", "read": true, "write": true, "create": true, "print": true, "report": true, "export": true },
    { "role": "Plastic Production Manager", "read": true, "report": true },
    { "role": "Plastic Planner", "read": true, "report": true },
    { "role": "System Manager", "read": true, "write": true, "create": true, "print": true, "report": true, "export": true, "share": true }
  ],
  "revision": 1
}
