{
  "name": "Plastic Recipe Policy",
  "module": "Plastic ERP",
  "is_submittable": true,
  "autoname": "PRCP-.YYYY.-#####",
  "title_field": "recipe_name",
  "search_fields": ["recipe_name", "bom", "output_item"],
  "sort_field": "effective_from",
  "sort_order": "DESC",
  "track_seen": true,
  "fields": [
    { "fieldname": "recipe_name", "label": "Tên công thức", "fieldtype": "Data", "required": true, "in_list_view": true, "search_index": true },
    { "fieldname": "company", "label": "Công ty", "fieldtype": "Link", "options": "Company", "required": true, "in_standard_filter": true },
    { "fieldname": "bom", "label": "BOM chuẩn", "fieldtype": "Link", "options": "Bill of Materials", "required": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "output_item", "label": "Thành phẩm", "fieldtype": "Link", "options": "Item", "required": true, "in_list_view": true },
    { "fieldname": "process_profile", "label": "Công nghệ", "fieldtype": "Link", "options": "Plastic Process Profile", "required": true, "in_list_view": true },
    { "fieldname": "revision_no", "label": "Revision", "fieldtype": "Int", "required": true, "default": 1, "in_list_view": true },
    { "fieldname": "effective_from", "label": "Hiệu lực từ", "fieldtype": "Date", "required": true, "in_list_view": true },
    { "fieldname": "effective_to", "label": "Hiệu lực đến", "fieldtype": "Date" },
    { "fieldname": "default_machine", "label": "Máy mặc định", "fieldtype": "Link", "options": "Plastic Machine" },
    { "fieldname": "default_tool", "label": "Khuôn / tool mặc định", "fieldtype": "Link", "options": "Plastic Tool" },
    { "fieldname": "target_cycle_seconds", "label": "Cycle mục tiêu giây", "fieldtype": "Float" },
    { "fieldname": "target_scrap_pct", "label": "Phế mục tiêu %", "fieldtype": "Float" },
    { "fieldname": "max_regrind_pct", "label": "Hạt nghiền tối đa %", "fieldtype": "Float" },
    { "fieldname": "drying_required", "label": "Bắt buộc sấy", "fieldtype": "Check" },
    { "fieldname": "mixing_required", "label": "Bắt buộc phối liệu", "fieldtype": "Check", "default": 1 },
    { "fieldname": "material_rules", "label": "Quy tắc nguyên liệu", "fieldtype": "Table", "options": "Plastic Recipe Material Rule", "required": true },
    { "fieldname": "qc_specification", "label": "Tiêu chuẩn QC", "fieldtype": "Link", "options": "Plastic Quality Specification" },
    { "fieldname": "approval_state", "label": "Trạng thái duyệt", "fieldtype": "Data", "read_only": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "change_reason", "label": "Lý do thay đổi", "fieldtype": "Text" }
  ],
  "viewPolicy": {
    "kanban": { "enabled": true, "stageField": "approval_state", "reasonRequiredOn": ["backward", "cancel"] },
    "mobile": { "compactFields": ["recipe_name", "bom", "output_item", "approval_state"] }
  },
  "permissions": [
    { "role": "Plastic Engineering User", "read": true, "write": true, "create": true, "submit": true, "cancel": true, "amend": true, "print": true, "report": true, "export": true },
    { "role": "Plastic Production Manager", "read": true, "report": true },
    { "role": "Plastic Planner", "read": true, "report": true },
    { "role": "Plastic Costing User", "read": true, "report": true },
    { "role": "System Manager", "read": true, "write": true, "create": true, "submit": true, "cancel": true, "amend": true, "print": true, "report": true, "export": true, "share": true }
  ],
  "revision": 1
}
