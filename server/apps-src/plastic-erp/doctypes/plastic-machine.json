    { "fieldname": "branch", "label": "Nhà máy / chi nhánh", "fieldtype": "Link", "options": "Branch", "required": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "process_profile", "label": "Công nghệ", "fieldtype": "Link", "options": "Plastic Process Profile", "required": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "asset", "label": "Tài sản", "fieldtype": "Link", "options": "Asset" },
    { "fieldname": "workstation", "label": "Workstation", "fieldtype": "Link", "options": "Workstation" },
    { "fieldname": "location", "label": "Vị trí", "fieldtype": "Link", "options": "Location" },
    { "fieldname": "capacity_min", "label": "Công suất tối thiểu", "fieldtype": "Float" },
    { "fieldname": "capacity_max", "label": "Công suất tối đa", "fieldtype": "Float" },
    { "fieldname": "clamp_force_ton", "label": "Lực kẹp tấn", "fieldtype": "Float" },
