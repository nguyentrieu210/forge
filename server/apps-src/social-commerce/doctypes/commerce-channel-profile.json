{
  "name": "Commerce Channel Profile",
  "label": "Cấu hình sàn TMĐT",
  "module": "Social Commerce",
  "kind": "master",
  "autoname": "field:channel_key",
  "title_field": "channel_name",
  "track_changes": true,
  "fields": [
    { "fieldname": "channel_key", "label": "Mã kênh", "fieldtype": "Data", "required": true, "unique": true, "in_list_view": true, "in_standard_filter": true, "set_only_once": true },
    { "fieldname": "channel_name", "label": "Tên gian hàng", "fieldtype": "Data", "required": true, "in_list_view": true },
    { "fieldname": "provider", "label": "Sàn", "fieldtype": "Select", "options": "shopee\nlazada\ntiktok_shop", "required": true, "in_list_view": true, "in_standard_filter": true, "set_only_once": true },
    { "fieldname": "connection_id", "label": "Kết nối Integration Hub", "fieldtype": "Link", "options": "Marketplace Connection", "required": true, "set_only_once": true, "description": "Link tới authority Integration Hub. Secret/token không được lưu trong DocType này." },
    { "fieldname": "external_shop_id", "label": "Mã gian hàng trên sàn", "fieldtype": "Data", "required": true, "set_only_once": true },
    { "fieldname": "company", "label": "Công ty", "fieldtype": "Link", "options": "Company", "required": true, "in_list_view": true },
    { "fieldname": "warehouse", "label": "Kho mặc định", "fieldtype": "Link", "options": "Warehouse", "required": true, "in_list_view": true },
    { "fieldname": "default_customer", "label": "Khách hàng mặc định", "fieldtype": "Link", "options": "Customer", "required": true, "description": "Dùng khi sàn không cung cấp canonical customer identity đủ để map khách hàng." },
    { "fieldname": "currency", "label": "Tiền tệ", "fieldtype": "Link", "options": "Currency", "required": true },
    { "fieldname": "selling_price_list", "label": "Bảng giá sàn", "fieldtype": "Link", "options": "Price List", "required": true },
    { "fieldname": "sync_orders", "label": "Đồng bộ đơn hàng", "fieldtype": "Check", "default": 1, "in_list_view": true },
    { "fieldname": "disabled", "label": "Ngừng sử dụng", "fieldtype": "Check", "default": 0, "in_list_view": true }
  ],
  "permissions": [
    { "role": "Social Commerce Manager", "read": true, "write": true, "create": true, "print": true, "report": true, "export": true },
    { "role": "Sales Manager", "read": true, "write": true, "create": true, "print": true, "report": true },
    { "role": "System Manager", "read": true, "write": true, "create": true, "print": true, "report": true, "export": true }
  ],
  "revision": 1
}
