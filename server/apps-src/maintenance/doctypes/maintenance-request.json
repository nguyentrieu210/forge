{
  "name": "Maintenance Request",
  "module": "Maintenance",
  "is_submittable": true,
  "autoname": "MR-.YYYY.-#####",
  "title_field": "summary",
  "search_fields": ["summary"],
  "sort_field": "reported_at",
  "sort_order": "DESC",
  "track_seen": true,
  "fields": [
    { "fieldname": "summary", "label": "Tóm tắt", "fieldtype": "Data", "required": true, "in_list_view": true, "search_index": true },
    { "fieldname": "customer", "label": "Khách hàng", "fieldtype": "Link", "options": "Customer", "required": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "priority", "label": "Mức ưu tiên", "fieldtype": "Link", "options": "Maintenance Priority", "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "reported_at", "label": "Thời điểm báo", "fieldtype": "Datetime", "required": true, "in_list_view": true },
    { "fieldname": "needs_parts", "label": "Cần vật tư", "fieldtype": "Check" },
    { "fieldname": "parts_note", "label": "Vật tư dự kiến", "fieldtype": "Data", "mandatory_depends_on": "eval:doc.needs_parts == 1" },
    { "fieldname": "detail", "label": "Mô tả", "fieldtype": "Text" },
    { "fieldname": "workflow_state", "label": "Trạng thái", "fieldtype": "Data", "read_only": true, "in_standard_filter": true }
  ],
  "permissions": [
    { "role": "Maintenance User", "read": true, "write": true, "create": true, "print": true, "report": true },
    { "role": "Maintenance Manager", "read": true, "write": true, "create": true, "submit": true, "cancel": true, "amend": true, "print": true, "report": true, "export": true, "share": true },
    { "role": "System Manager", "read": true, "write": true, "create": true, "submit": true, "cancel": true, "amend": true, "print": true, "report": true, "export": true, "share": true }
  ],
  "revision": 1
}
