{
  "name": "Warranty Claim",
  "module": "Maintenance",
  "is_submittable": true,
  "autoname": "WC-.YYYY.-#####",
  "title_field": "complaint",
  "search_fields": ["customer", "company", "branch", "serial_no", "item", "service_contract", "source_delivery_note"],
  "sort_field": "claim_date",
  "sort_order": "DESC",
  "track_seen": true,
  "fields": [
    { "fieldname": "claim_date", "label": "Ngày tiếp nhận", "fieldtype": "Date", "required": true, "in_list_view": true },
    { "fieldname": "customer", "label": "Khách hàng", "fieldtype": "Link", "options": "Customer", "required": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "company", "label": "Công ty", "fieldtype": "Link", "options": "Company", "mandatory_depends_on": "eval:doc.workflow_state && doc.workflow_state != 'Mới'", "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "branch", "label": "Chi nhánh", "fieldtype": "Link", "options": "Branch", "in_standard_filter": true },
    { "fieldname": "maintenance_request", "label": "Yêu cầu nguồn", "fieldtype": "Link", "options": "Maintenance Request", "in_standard_filter": true },
    { "fieldname": "service_contract", "label": "Hợp đồng dịch vụ / bảo hành", "fieldtype": "Link", "options": "Service Contract", "in_standard_filter": true },
    { "fieldname": "source_delivery_note", "label": "Phiếu giao hàng nguồn", "fieldtype": "Link", "options": "Delivery Note", "mandatory_depends_on": "eval:doc.workflow_state && doc.workflow_state != 'Mới'", "in_standard_filter": true },
    { "fieldname": "item", "label": "Sản phẩm / vật tư", "fieldtype": "Link", "options": "Item", "required": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "serial_no", "label": "Số serial", "fieldtype": "Link", "options": "Serial No", "in_list_view": true, "search_index": true },
    { "fieldname": "complaint", "label": "Nội dung khiếu nại / lỗi", "fieldtype": "Text", "required": true },
    { "fieldname": "eligibility_result", "label": "Kết quả xác minh quyền lợi", "fieldtype": "Select", "options": "Chưa xác minh\nĐủ điều kiện\nKhông đủ điều kiện", "default": "Chưa xác minh", "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "eligibility_reason", "label": "Căn cứ xác minh", "fieldtype": "Text", "mandatory_depends_on": "eval:doc.workflow_state == 'Đủ điều kiện' || doc.workflow_state == 'Từ chối'" },
    { "fieldname": "correction_of", "label": "Điều chỉnh yêu cầu bảo hành", "fieldtype": "Link", "options": "Warranty Claim", "in_standard_filter": true },
    { "fieldname": "correction_reason", "label": "Lý do điều chỉnh", "fieldtype": "Text", "mandatory_depends_on": "eval:!!doc.correction_of" },
    { "fieldname": "service_order", "label": "Lệnh dịch vụ xử lý", "fieldtype": "Link", "options": "Service Order" },
    { "fieldname": "resolution_date", "label": "Thời điểm xử lý xong", "fieldtype": "Datetime", "mandatory_depends_on": "eval:doc.workflow_state == 'Chờ xác nhận' || doc.workflow_state == 'Hoàn tất'" },
    { "fieldname": "resolution", "label": "Kết quả xử lý", "fieldtype": "Text", "mandatory_depends_on": "eval:doc.workflow_state == 'Chờ xác nhận' || doc.workflow_state == 'Hoàn tất'" },
    { "fieldname": "customer_confirmed_by", "label": "Người xác nhận phía khách", "fieldtype": "Data", "mandatory_depends_on": "eval:doc.workflow_state == 'Hoàn tất'" },
    { "fieldname": "rejection_reason", "label": "Lý do từ chối", "fieldtype": "Text", "mandatory_depends_on": "eval:doc.workflow_state == 'Từ chối'" },
    { "fieldname": "cancel_reason", "label": "Lý do hủy", "fieldtype": "Text", "mandatory_depends_on": "eval:doc.workflow_state == 'Hủy'" },
    { "fieldname": "workflow_state", "label": "Trạng thái", "fieldtype": "Data", "read_only": true, "in_list_view": true, "in_standard_filter": true }
  ],
  "viewPolicy": {
    "kanban": { "enabled": true, "stageField": "workflow_state", "reasonRequiredOn": ["backward", "cancel"] },
    "mobile": { "compactFields": ["customer", "company", "item", "serial_no", "eligibility_result", "workflow_state"] }
  },
  "permissions": [
    { "role": "Maintenance User", "read": true, "write": true, "create": true, "print": true, "report": true },
    { "role": "Maintenance Technician", "read": true, "write": true, "print": true },
    { "role": "Maintenance Manager", "read": true, "write": true, "create": true, "submit": true, "cancel": true, "amend": true, "print": true, "report": true, "export": true, "share": true },
    { "role": "System Manager", "read": true, "write": true, "create": true, "submit": true, "cancel": true, "amend": true, "print": true, "report": true, "export": true, "share": true }
  ],
  "revision": 2
}
