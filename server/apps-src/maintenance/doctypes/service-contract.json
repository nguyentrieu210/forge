{
  "name": "Service Contract",
  "module": "Maintenance",
  "is_submittable": true,
  "autoname": "SC-.YYYY.-#####",
  "title_field": "contract_title",
  "search_fields": ["contract_title", "customer"],
  "sort_field": "effective_from",
  "sort_order": "DESC",
  "track_seen": true,
  "fields": [
    { "fieldname": "contract_title", "label": "Tên hợp đồng / gói dịch vụ", "fieldtype": "Data", "required": true, "in_list_view": true, "search_index": true },
    { "fieldname": "customer", "label": "Khách hàng", "fieldtype": "Link", "options": "Customer", "required": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "contract_type", "label": "Loại hợp đồng", "fieldtype": "Select", "options": "Bảo hành\nAMC\nBảo trì định kỳ", "required": true, "in_list_view": true, "in_standard_filter": true },
    { "fieldname": "source_delivery_note", "label": "Phiếu giao hàng nguồn", "fieldtype": "Link", "options": "Delivery Note" },
    { "fieldname": "effective_from", "label": "Hiệu lực từ", "fieldtype": "Date", "required": true, "in_list_view": true },
    { "fieldname": "effective_to", "label": "Hiệu lực đến", "fieldtype": "Date", "required": true, "in_list_view": true },
    { "fieldname": "response_hours", "label": "Cam kết phản hồi (giờ)", "fieldtype": "Int", "required": true },
    { "fieldname": "resolution_hours", "label": "Cam kết xử lý (giờ)", "fieldtype": "Int", "required": true },
    { "fieldname": "visits_included", "label": "Số lượt dịch vụ gồm trong gói", "fieldtype": "Int", "default": 0 },
    { "fieldname": "parts_covered", "label": "Bao gồm vật tư / linh kiện", "fieldtype": "Check" },
    { "fieldname": "covered_items", "label": "Sản phẩm được bảo trì / bảo hành", "fieldtype": "Table", "options": "Service Contract Item", "required": true },
    { "fieldname": "terms", "label": "Điều khoản dịch vụ", "fieldtype": "Text", "required": true },
    { "fieldname": "approval_note", "label": "Ghi chú phê duyệt", "fieldtype": "Text" },
    { "fieldname": "cancel_reason", "label": "Lý do hủy", "fieldtype": "Text", "mandatory_depends_on": "eval:doc.workflow_state == 'Hủy'" },
    { "fieldname": "workflow_state", "label": "Trạng thái", "fieldtype": "Data", "read_only": true, "in_list_view": true, "in_standard_filter": true }
  ],
  "viewPolicy": {
    "kanban": { "enabled": true, "stageField": "workflow_state", "reasonRequiredOn": ["cancel"] },
    "mobile": { "compactFields": ["contract_title", "customer", "contract_type", "effective_to", "workflow_state"] }
  },
  "permissions": [
    { "role": "Maintenance User", "read": true, "print": true, "report": true },
    { "role": "Maintenance Technician", "read": true },
    { "role": "Maintenance Manager", "read": true, "write": true, "create": true, "submit": true, "cancel": true, "amend": true, "print": true, "report": true, "export": true, "share": true },
    { "role": "System Manager", "read": true, "write": true, "create": true, "submit": true, "cancel": true, "amend": true, "print": true, "report": true, "export": true, "share": true }
  ],
  "revision": 1
}
