{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/app-brief.schema.json",
  "title": "Forge application brief",
  "type": "object",
  "required": [
    "id",
    "name",
    "doctypes"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "platformRequires": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "module": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "brand": {
      "enum": [
        "zinc",
        "blue",
        "warm",
        "sakura",
        "emerald",
        "ocean",
        "violet",
        "indigo",
        "teal",
        "amber",
        "rose",
        "aurora",
        "sunset"
      ]
    },
    "design": {
      "type": "object",
      "description": "Ngôn ngữ hiển thị của app, tách khỏi màu brand. Runtime áp đồng nhất cho Desk và màn riêng.",
      "additionalProperties": false,
      "properties": {
        "density": {
          "enum": ["compact", "comfortable", "touch"]
        },
        "radius": {
          "enum": ["square", "soft", "round"]
        },
        "contentWidth": {
          "enum": ["contained", "wide", "fluid"]
        }
      }
    },
    "catalogMode": {
      "enum": [
        "manifest",
        "workspace",
        "hybrid"
      ]
    },
    "dimensions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "company",
          "fiscal_year",
          "warehouse",
          "branch",
          "cost_center",
          "project",
          "territory",
          "selling_price_list",
          "buying_price_list"
        ]
      }
    },
    "worker": {
      "type": "string",
      "description": "Worker trong dispatch namespace nhận validator và app method của app này."
    },
    "validators": {
      "type": "array",
      "description": "Ghi mà app muốn KIỂM trước khi commit. Cần `worker`.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "doctype"
        ],
        "properties": {
          "doctype": {
            "type": "string"
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "roles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "home": {
      "type": "string",
      "minLength": 1
    },
    "navigation": {
      "type": "object",
      "description": "Thứ tự hiển thị sidebar. Nhóm hoặc mục không liệt kê được giữ nguyên và nằm sau phần đã ưu tiên.",
      "additionalProperties": false,
      "properties": {
        "groups": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "items": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "fixtures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fixture"
      }
    },
    "locale": {
      "type": "object",
      "properties": {
        "numberFormat": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "dateFormat": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "doctypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/doctype"
      }
    },
    "storefront": {
      "type": "object",
      "description": "Mặt tiền CÔNG KHAI: khách không đăng nhập đọc được gì, và đặt hàng thế nào. `fields` là DANH SÁCH TRẮNG — field không liệt kê thì không bao giờ ra ngoài (giá vốn, giá đại lý, tồn kho nằm ngay cạnh giá lẻ trên cùng doctype).",
      "additionalProperties": false,
      "required": [
        "catalog"
      ],
      "properties": {
        "catalog": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "doctype",
            "publishedField",
            "slugField",
            "priceField",
            "fields"
          ],
          "properties": {
            "doctype": {
              "type": "string",
              "description": "Phải là doctype brief này khai."
            },
            "publishedField": {
              "type": "string",
              "description": "Field Check quyết định bản ghi có ra trang công khai không."
            },
            "slugField": {
              "type": "string",
              "description": "Field duy nhất dùng làm đường dẫn sản phẩm."
            },
            "priceField": {
              "type": "string",
              "description": "Giá SERVER dùng để tính tiền đơn hàng. Giá do client gửi bị bỏ qua."
            },
            "facetField": {
              "type": "string",
              "description": "Field cho phép lọc, vd nhóm hàng."
            },
            "fields": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "search": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Field cho tìm kiếm — phải nằm trong `fields`."
            }
          }
        },
        "order": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "doctype",
            "role",
            "lines",
            "placedAt",
            "total",
            "trackBy",
            "buyerFields"
          ],
          "properties": {
            "doctype": {
              "type": "string"
            },
            "role": {
              "type": "string",
              "description": "Vai trò đơn công khai chạy dưới. Trần quyền do DocPerm của vai trò này quyết."
            },
            "lines": {
              "type": "string",
              "description": "Field bảng chứa dòng hàng."
            },
            "placedAt": {
              "type": "string",
              "description": "Field Datetime do SERVER đóng dấu."
            },
            "total": {
              "type": "string",
              "description": "Field Currency server cộng vào."
            },
            "trackBy": {
              "type": "string",
              "description": "Yếu tố thứ hai để tra cứu, ngoài mã đơn. Chỉ mã đơn là dãy đoán được."
            },
            "buyerFields": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "maxPerDay": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          }
        }
      }
    },
    "customFields": {
      "type": "object",
      "description": "Field app thêm vào DocType CHUẨN (Item, Customer…) — thứ app không sở hữu. Khóa là tên DocType, giá trị là mảng field viết theo đúng ngôn ngữ trường của `fields`. KHÔNG dùng cho doctype do chính brief này khai.",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 3
            },
            {
              "type": "object",
              "required": [
                "field"
              ],
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 3
                },
                "after": {
                  "type": "string",
                  "description": "Tên field chuẩn để chèn ngay sau. Bỏ trống thì field nằm cuối form."
                }
              }
            }
          ]
        }
      }
    },
    "reports": {
      "type": "array",
      "description": "Báo cáo bảng trên chính doctype của app. Cột viết gọn: \"field:Type Nhãn\" hoặc \"sum(field):Currency Nhãn\".",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "doctype",
          "columns"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Cũng là id trong /report/<name>."
          },
          "label": {
            "type": "string"
          },
          "doctype": {
            "type": "string",
            "description": "Doctype được đọc; quyền kiểm trên chính doctype này."
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "groupBy": {
            "type": "string",
            "description": "Một field để gộp. Có cột gộp thì BẮT BUỘC có."
          },
          "orderBy": {
            "type": "string",
            "description": "vd \"sum(amount) desc\" — phải là một cột của báo cáo."
          },
          "filters": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Field người dùng được phép lọc."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000
          },
          "group": {
            "type": "string",
            "description": "Nhóm menu. Mặc định \"Báo cáo\"."
          },
          "icon": {
            "type": "string"
          }
        },
        "patternProperties": {
          "^//": true
        }
      }
    },
    "actions": {
      "type": "array",
      "description": "Thao tác dạng form: điền ô rồi bấm chạy, gọi method của Worker app. Dùng cho việc KHÔNG phải là sửa một bản ghi (vd cắt nhôm: chọn lô, trừ tồn, ghi phiếu cắt). Cần `worker`.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "permission",
          "commit",
          "fields"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Cũng là id trong /x/action:<name>."
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "permission": {
            "type": "string",
            "description": "Doctype dùng để chặn quyền vào màn (quyền GHI). Phải là doctype brief này khai."
          },
          "permissionAction": {
            "type": "string",
            "enum": [
              "read",
              "save"
            ],
            "description": "Quyền cần có trên doctype chặn. Mặc định save; dùng read cho thao tác chỉ đọc."
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/field"
            },
            "description": "Cùng cú pháp với field của doctype: \"profile:Link(Item)! Mã nhôm\"."
          },
          "preview": {
            "$ref": "#/$defs/actionCall",
            "description": "Method CHỈ ĐỌC, cho xem trước điều sắp xảy ra."
          },
          "commit": {
            "$ref": "#/$defs/actionCall",
            "description": "Method GHI THẬT. Thêm phần thứ ba để hỏi lại trước khi chạy."
          },
          "resultTable": {
            "type": "string",
            "description": "Khoá trong kết quả chứa mảng dòng, để hiện thành bảng."
          },
          "group": {
            "type": "string",
            "description": "Nhóm menu. Mặc định \"Thao tác\"."
          },
          "menu": {
            "type": "boolean",
            "description": "false = vẫn cài action nhưng không hiện thành một dòng riêng trên sidebar."
          },
          "icon": {
            "type": "string"
          }
        },
        "patternProperties": {
          "^//": true
        }
      }
    },
    "screens": {
      "type": "array",
      "description": "Màn nghiệp vụ riêng được ghép từ block an toàn và đi cùng gói app. Không cần build frontend riêng.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "permission", "blocks"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "maxLength": 64
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "permission": {
            "type": "string",
            "description": "DocType dùng để chặn quyền đọc màn."
          },
          "mode": {
            "enum": ["desk", "focus", "touch"]
          },
          "columns": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "group": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "menu": {
            "type": "boolean"
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "type", "label", "doctype"],
                  "properties": {
                    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                    "type": { "const": "metric" },
                    "label": { "type": "string" },
                    "description": { "type": "string" },
                    "icon": { "type": "string" },
                    "span": { "type": "integer", "minimum": 1, "maximum": 3 },
                    "doctype": { "type": "string" },
                    "filters": { "type": "object" },
                    "tone": { "enum": ["neutral", "info", "success", "warning", "danger"] },
                    "route": { "type": "string", "pattern": "^/" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "type", "label", "doctype", "fields"],
                  "properties": {
                    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                    "type": { "const": "list" },
                    "label": { "type": "string" },
                    "description": { "type": "string" },
                    "icon": { "type": "string" },
                    "span": { "type": "integer", "minimum": 1, "maximum": 3 },
                    "doctype": { "type": "string" },
                    "fields": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": { "type": "string" }
                    },
                    "filters": { "type": "object" },
                    "orderBy": { "type": "string" },
                    "limit": { "type": "integer", "minimum": 1, "maximum": 50 },
                    "emptyText": { "type": "string" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "type", "label", "action"],
                  "properties": {
                    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                    "type": { "const": "action" },
                    "label": { "type": "string" },
                    "description": { "type": "string" },
                    "icon": { "type": "string" },
                    "span": { "type": "integer", "minimum": 1, "maximum": 3 },
                    "action": { "type": "string" }
                  }
                }
              ]
            }
          }
        },
        "patternProperties": {
          "^//": true
        }
      }
    },
    "experiences": {
      "type": "array",
      "description": "Màn vận hành native do runtime chung cung cấp; app chỉ chọn màn và DocType chặn quyền.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "permission", "roles"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[^:]+$", "maxLength": 160 },
          "label": { "type": "string", "minLength": 1, "maxLength": 160 },
          "permission": { "type": "string", "minLength": 1, "maxLength": 160 },
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 160 }
          },
          "icon": { "type": "string" },
          "group": { "type": "string" }
        },
        "patternProperties": { "^//": true }
      }
    },
    "prints": {
      "type": "array",
      "description": "Mẫu in do app khai. Lặp dòng hàng: {{#each items}} … {{/each}}. Định dạng tiền: {{ grand_total | money }}. Ngày: {{ posting_at | date }}.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "patternProperties": {
          "^//": true
        },
        "required": [
          "name",
          "doctype",
          "html"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "doctype": {
            "type": "string",
            "description": "Phải là doctype brief này khai."
          },
          "html": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "description": "Chuỗi, hoặc mảng dòng cho dễ đọc."
          },
          "css": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "default": {
            "type": "boolean",
            "description": "Mặc định true. Mẫu mặc định là mẫu nút In dùng."
          }
        }
      }
    },
    "links": {
      "type": "array",
      "description": "Mục menu trỏ tới BÁO CÁO SẴN CÓ của nền tảng (Stock Balance, General Ledger, Trial Balance…). Không có nó thì hai chục báo cáo đã chạy được vẫn không ai nhìn thấy.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "patternProperties": {
          "^//": true
        },
        "required": [
          "report"
        ],
        "properties": {
          "report": {
            "type": "string",
            "description": "Tên báo cáo của nền tảng, đúng chính tả."
          },
          "label": {
            "type": "string"
          },
          "permission": {
            "type": "string",
            "description": "Doctype dùng để chặn quyền. Bỏ trống thì hiện cho mọi vai trò."
          },
          "group": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          }
        }
      }
    },
    "hooks": {
      "type": "array",
      "description": "Sự kiện app muốn nhận SAU KHI ghi sổ (vd purchase_receipt.submitted). Cần `worker`. Chỉ cho ký tự đại diện ở cuối.",
      "items": {
        "type": "string",
        "pattern": "^([*]|[a-z0-9_]+([.][a-z0-9_]+)*([.][*])?)$"
      }
    }
  },
  "patternProperties": {
    "^//": true
  },
  "additionalProperties": false,
  "$defs": {
    "dependency": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
        }
      },
      "additionalProperties": false
    },
    "fixture": {
      "description": "Bản ghi danh mục cài kèm app. Ghi chú `//` được phép ở đây như ở mọi nơi khác trong ngôn ngữ brief — thiếu `patternProperties` thì fixture là chỗ DUY NHẤT không chú thích được, mà fixture Công ty lại đúng là chỗ cần chú thích nhất: hai khoá `default_*_account` của nó bật/tắt bút toán giá vốn, và không tên field nào trên chứng từ nói ra điều đó.",
      "type": "object",
      "required": [
        "type",
        "name"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object"
        }
      },
      "patternProperties": {
        "^//": true
      },
      "additionalProperties": false
    },
    "field": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9_]*:"
        },
        {
          "type": "object",
          "required": [
            "fieldname",
            "fieldtype"
          ],
          "properties": {
            "fieldname": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "fieldtype": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string"
            },
            "options": {
              "type": "string"
            },
            "required": {
              "type": "boolean"
            },
            "unique": {
              "type": "boolean"
            },
            "read_only": {
              "type": "boolean"
            },
            "default": {}
          },
          "additionalProperties": true
        }
      ]
    },
    "actionCall": {
      "description": "Một method của Worker app. Viết gọn \"method | nhãn nút | câu hỏi xác nhận\", hoặc dạng object.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "method"
          ],
          "additionalProperties": false,
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string"
            },
            "confirm": {
              "type": "string"
            }
          }
        }
      ]
    },
    "workflow": {
      "type": "object",
      "required": [
        "states",
        "transitions"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "field": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string"
        },
        "states": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "enum": [
              0,
              1,
              2
            ]
          }
        },
        "transitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "array",
                "minItems": 4,
                "maxItems": 5,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              {
                "type": "object",
                "required": [
                  "from",
                  "action",
                  "to",
                  "role"
                ],
                "properties": {
                  "from": {
                    "type": "string"
                  },
                  "action": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string"
                  },
                  "self": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "doctype": {
      "type": "object",
      "required": [
        "name",
        "fields",
        "permissions"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "naming": {
          "type": "string"
        },
        "allow_rename": {
          "type": "boolean",
          "description": "Cho phép đổi name/mã sau khi lưu qua thao tác Rename an toàn của runtime."
        },
        "title": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "search": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "list": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "inbox": {
          "type": "boolean"
        },
        "inboxLabel": {
          "type": "string"
        },
        "inboxIcon": {
          "type": "string"
        },
        "inboxGroup": {
          "type": "string"
        },
        "calendar": {
          "type": "object",
          "description": "Thêm màn lịch tuần/tháng cho doctype này. Runtime tự suy field ngày và field giờ từ metadata; app chỉ nói CÓ muốn màn đó hay không.",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string"
            },
            "icon": {
              "type": "string"
            },
            "group": {
              "type": "string"
            }
          }
        },
        "submittable": {
          "type": "boolean"
        },
        "tree": {
          "type": "boolean",
          "description": "DocType cây cha-con. Phải có field parent_<doctype snake_case>; runtime tự dùng Tree View."
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "permissions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^(?!.*(.).*\\1)[rwcsxa]+$"
          }
        },
        "workflow": {
          "$ref": "#/$defs/workflow"
        },
        "child": {
          "type": "boolean",
          "description": "Doctype CON — chỉ là dòng của bảng cha. Không lên menu, không có danh sách riêng."
        },
        "menu": {
          "type": "boolean",
          "description": "`false` = CÀI ĐẶT nhưng không lên menu. Khác hẳn xoá khỏi brief: xoá thì định nghĩa thành mồ côi và bản ghi cũ không còn schema nào mô tả — không đọc được, không xuất được. Dùng khi khách chỉ dùng hai trong mười loại chứng từ nền tảng có; tám cái kia vẫn chạy, chỉ không chiếm chỗ trên thanh bên."
        }
      },
      "patternProperties": {
        "^//": true
      },
      "additionalProperties": false
    }
  }
}
