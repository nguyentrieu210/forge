{
  "//purpose": "MetaForm 4.1 operational profile. Presentation only: canonical DocTypes and server business authority stay unchanged.",
  "version": "2.4.0",
  "doctypes": {
    "Sales Order": {
      "form": {
        "presentation": "workspace",
        "density": "compact",
        "fullWidth": true,
        "header": {
          "tone": "brand",
          "keyFields": ["customer", "customer_group", "transaction_date", "delivery_date", "selling_price_list", "responsible_person"]
        },
        "composition": {
          "columns": 12,
          "blocks": [
            {
              "key": "sales_context",
              "type": "fields",
              "span": 8,
              "title": "Thông tin đơn bán",
              "description": "Khách hàng, ngày đặt/giao và điều kiện thương mại trong một vùng thao tác.",
              "fields": ["customer", "customer_group", "transaction_date", "delivery_date", "selling_price_list", "responsible_person"],
              "fieldSpans": {
                "customer": 8,
                "customer_group": 4,
                "transaction_date": 4,
                "delivery_date": 4,
                "selling_price_list": 4,
                "responsible_person": 12
              }
            },
            {
              "key": "sales_value",
              "type": "stats",
              "span": 4,
              "title": "Giá trị đơn",
              "tone": "brand",
              "items": [
                { "field": "grand_total", "label": "Tổng cộng", "format": "currency", "emphasis": "grand" }
              ]
            }
          ]
        },
        "summary": {
          "enabled": true,
          "position": "bottom-right",
          "items": [
            { "field": "grand_total", "label": "TỔNG CỘNG", "emphasis": "grand" }
          ]
        }
      }
    },
    "Sales Order Item": {
      "listColumns": ["item_code", "color", "width_m", "height_m", "set_count", "billable_area_sqm", "qty", "uom", "rate", "amount"],
      "grid": {
        "density": "compact",
        "headerTone": "brand",
        "autoBorders": true,
        "stripe": "alternating",
        "stripeScope": "record",
        "frozenColumns": 1,
        "columnGroups": [
          { "key": "product", "label": "SẢN PHẨM", "tone": "brand", "fields": ["item_code", "color"] },
          { "key": "dimensions", "label": "KÍCH THƯỚC", "tone": "input", "fields": ["width_m", "height_m", "set_count"] },
          { "key": "formula", "label": "TÍNH TOÁN", "tone": "result", "fields": ["billable_area_sqm", "qty", "uom"] },
          { "key": "commercial", "label": "THƯƠNG MẠI", "tone": "commercial", "fields": ["rate", "amount"] }
        ],
        "secondaryRow": {
          "fields": ["billable_area_sqm"]
        }
      },
      "fieldRoles": {
        "item_code": "operator_input",
        "color": "optional_input",
        "width_m": "operator_input",
        "height_m": "operator_input",
        "set_count": "operator_input",
        "billable_area_sqm": "formula",
        "rate": "money",
        "amount": "money"
      }
    },
    "Purchase Order": {
      "form": {
        "presentation": "workspace",
        "density": "compact",
        "fullWidth": true,
        "header": {
          "tone": "brand",
          "keyFields": ["supplier", "priority", "transaction_date", "schedule_date"]
        },
        "composition": {
          "columns": 12,
          "blocks": [
            {
              "key": "purchase_context",
              "type": "fields",
              "span": 8,
              "title": "Thông tin đơn mua",
              "description": "Nhà cung cấp, mức ưu tiên và lịch đặt/giao được gom thành một vùng thao tác.",
              "fields": ["supplier", "priority", "transaction_date", "schedule_date"],
              "fieldSpans": {
                "supplier": 12,
                "priority": 4,
                "transaction_date": 4,
                "schedule_date": 4
              }
            },
            {
              "key": "purchase_value",
              "type": "stats",
              "span": 4,
              "title": "Giá trị đơn",
              "tone": "brand",
              "items": [
                { "field": "grand_total", "label": "Tổng đơn mua", "format": "currency", "emphasis": "grand" }
              ]
            }
          ]
        },
        "summary": {
          "enabled": true,
          "position": "bottom-right",
          "items": [
            { "field": "grand_total", "label": "TỔNG ĐƠN MUA", "emphasis": "grand" }
          ]
        }
      }
    },
    "Purchase Order Item": {
      "listColumns": ["item_code", "color", "length_m", "qty_bar", "theoretical_kg", "qty", "uom", "rate", "amount", "warehouse"],
      "grid": {
        "density": "compact",
        "headerTone": "brand",
        "autoBorders": true,
        "stripe": "alternating",
        "stripeScope": "record",
        "frozenColumns": 1,
        "columnGroups": [
          { "key": "product", "label": "MẶT HÀNG", "tone": "brand", "fields": ["item_code", "color"] },
          { "key": "dimensions", "label": "QUY CÁCH", "tone": "input", "fields": ["length_m", "qty_bar", "theoretical_kg"] },
          { "key": "quantity", "label": "SỐ LƯỢNG", "tone": "result", "fields": ["qty", "uom"] },
          { "key": "commercial", "label": "GIÁ MUA", "tone": "commercial", "fields": ["rate", "amount"] },
          { "key": "warehouse", "label": "NHẬP KHO", "tone": "neutral", "fields": ["warehouse"] }
        ],
        "secondaryRow": {
          "fields": ["length_m", "qty_bar", "theoretical_kg", "warehouse"]
        }
      },
      "fieldRoles": {
        "item_code": "operator_input",
        "color": "optional_input",
        "length_m": "operator_input",
        "qty_bar": "operator_input",
        "theoretical_kg": "formula",
        "qty": "operator_input",
        "rate": "money",
        "amount": "money",
        "warehouse": "optional_input"
      }
    }
  }
}
