      "html": [
        "<div class=\"letterhead\"><div class=\"brand-logo-text\">ALUMDOOR</div><div class=\"brand-tagline\">CỬA CUỐN CÔNG NGHỆ ĐỨC / ÚC</div><img class=\"company-header-img\" src=\"/alumdoor-company-header.png\" alt=\"Thông tin công ty ALUMDOOR\"></div>",
        "<div class=\"title\">PHIẾU YÊU CẦU SẢN XUẤT</div>",
        "<div class=\"meta\">",
        "<div class=\"meta-row\"><span class=\"meta-label\">Số yêu cầu:</span><span class=\"meta-value\">{{ name }}</span></div>",
        "<div class=\"meta-row\"><span class=\"meta-label\">Theo đơn bán:</span><span class=\"meta-value\">{{ sales_order }}</span></div>",
        "<div class=\"meta-row\"><span class=\"meta-label\">Khách hàng:</span><span class=\"meta-value\">{{ customer }}</span></div>",
        "<div class=\"meta-row\"><span class=\"meta-label\">Lập lúc:</span><span class=\"meta-value\">{{ requested_on | date }}</span></div>",
        "<div class=\"meta-row\"><span class=\"meta-label\">Ngày hẹn giao:</span><span class=\"meta-value\">{{ delivery_date | date }}</span></div>",
        "<div class=\"meta-row\"><span class=\"meta-label\">Trạng thái:</span><span class=\"meta-value\">{{ request_state }}</span></div>",
        "<div class=\"meta-row wide\"><span class=\"meta-label\">Kho nguyên vật liệu:</span><span class=\"meta-value\">{{ source_warehouse }}</span></div>",
        "<div class=\"meta-row wide\"><span class=\"meta-label\">Kho thành phẩm:</span><span class=\"meta-value\">{{ target_warehouse }}</span></div>",
        "</div>",
        "<table><colgroup><col style=\"width:3%\"><col style=\"width:4%\"><col style=\"width:5%\"><col style=\"width:8%\"><col style=\"width:9%\"><col style=\"width:7%\"><col style=\"width:6%\"><col style=\"width:6%\"><col style=\"width:6%\"><col style=\"width:7%\"><col style=\"width:6%\"><col style=\"width:10%\"><col style=\"width:8%\"><col style=\"width:15%\"></colgroup><thead><tr>",
        "<th class=\"index-col\">STT</th><th>Bộ số</th><th>Số bộ</th><th>Mã TP</th><th>Loại cửa</th><th>Bộ phận</th><th>Màu</th><th>Rộng (m)</th><th>Cao (m)</th><th>Rộng cắt (m)</th><th>Số lá</th><th>Mô tơ / cảnh báo</th><th>Phút dự toán</th><th>Kho vật tư</th>",
        "</tr></thead><tbody>",
        "{{#each items}}<tr><td class=\"c index-col\">{{ _index }}</td><td class=\"n\">{{ set_no | number }}</td><td class=\"n\">{{ set_count | number }}</td><td class=\"code\">{{ item_code }}</td><td>{{ door_type }}</td><td>{{ department }}</td><td class=\"c\">{{ color }}</td><td class=\"n\">{{ width_m | number }}</td><td class=\"n\">{{ height_m | number }}</td><td class=\"n\">{{ cut_width_m | number }}</td><td class=\"n\">{{ leaf_count | number }}</td><td class=\"detail-cell\">{{ motor_model }}<br><span class=\"muted\">{{ schedule_warning }}</span></td><td class=\"n\">{{ estimated_minutes | number }}</td><td class=\"warehouse-cell\">{{ source_warehouse }}</td></tr>{{/each}}",
        "</tbody></table>",
        "<div class=\"footer-note\"><b>Ghi chú:</b>{{ note }}</div>",
        "<div class=\"sign\"><div><b>Kinh doanh / Người lập</b>(ký, ghi rõ họ tên)</div><div><b>Bộ phận sản xuất nhận</b>(ký, ghi rõ họ tên)</div><div><b>Chủ xưởng duyệt</b>(ký, ghi rõ họ tên)</div></div>"
      ]
