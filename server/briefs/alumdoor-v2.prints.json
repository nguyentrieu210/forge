        "table{width:100%;border-collapse:collapse;table-layout:fixed}thead{display:table-header-group}tr{break-inside:avoid;page-break-inside:avoid}th,td{border:1px solid #777;padding:4pt 1.5pt;vertical-align:middle;text-align:center;line-height:1.25}",
        "th{background:#f3f3f3;font-size:7.2pt;text-transform:uppercase;white-space:normal}td{font-size:7.8pt;white-space:normal;overflow-wrap:anywhere}.n,.c{text-align:center;font-variant-numeric:tabular-nums}.code{font-weight:700}.item-cell,.warehouse-cell{white-space:normal;overflow-wrap:anywhere}.index-col,.nowrap{white-space:nowrap}",
