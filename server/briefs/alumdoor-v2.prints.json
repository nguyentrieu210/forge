      "html": [
        "<div class=\"letterhead\"><div class=\"brand-logo-text\">ALUMDOOR</div><div class=\"brand-tagline\">CỬA CUỐN CÔNG NGHỆ ĐỨC / ÚC</div><img class=\"company-header-img\" src=\"/alumdoor-company-header.png\" alt=\"Thông tin công ty ALUMDOOR\"></div>",
        "<div class=\"title\">PHIẾU GIAO HÀNG / LẮP ĐẶT</div>",
        "<div class=\"meta\">",
        "<div class=\"meta-row\"><span class=\"meta-label\">Khách hàng:</span><span class=\"meta-value\">{{ customer }}</span></div>",
        "<div class=\"meta-row\"><span class=\"meta-label\">Số phiếu:</span><span class=\"meta-value\">{{ name }}</span></div>",
        "<div class=\"meta-row\"><span class=\"meta-label\">Mục đích xuất:</span><span class=\"meta-value\">{{ issue_purpose }}</span></div>",
        "<div class=\"meta-row\"><span class=\"meta-label\">Ngày xuất:</span><span class=\"meta-value\">{{ posting_at | date }}</span></div>",
        "<div class=\"meta-row\"><span class=\"meta-label\">Theo đơn bán:</span><span class=\"meta-value\">{{ against_sales_order }}</span></div>",
        "<div class=\"meta-row\"><span class=\"meta-label\">Ngày lắp:</span><span class=\"meta-value\">{{ install_date | date }}</span></div>",
        "<div class=\"meta-row\"><span class=\"meta-label\">Đội lắp:</span><span class=\"meta-value\">{{ installer }}</span></div>",
        "<div class=\"meta-row\"><span class=\"meta-label\">Người giao / lái xe:</span><span class=\"meta-value\">{{ driver }}</span></div>",
        "<div class=\"meta-row\"><span class=\"meta-label\">Biển số xe:</span><span class=\"meta-value\">{{ vehicle }}</span></div>",
        "<div class=\"meta-row wide\"><span class=\"meta-label\">Giao / lắp tại:</span><span class=\"meta-value\">{{ install_address }}</span></div>",
        "</div>",
        "<table><colgroup><col style=\"width:3%\"><col style=\"width:9%\"><col style=\"width:17%\"><col style=\"width:7%\"><col style=\"width:6%\"><col style=\"width:6%\"><col style=\"width:6%\"><col style=\"width:8%\"><col style=\"width:5%\"><col style=\"width:18%\"><col style=\"width:15%\"></colgroup><thead><tr>",
        "<th class=\"index-col\">STT</th><th>Mã hàng</th><th>Tên hàng</th><th>Màu sắc</th><th>Rộng (m)</th><th>Cao (m)</th><th>Số bộ</th><th>SL giao</th><th>ĐVT</th><th>Kho xuất</th><th>Khối lượng (kg)</th>",
        "</tr></thead><tbody>",
        "{{#each items}}<tr><td class=\"c index-col\">{{ _index }}</td><td class=\"code\">{{ item_code }}</td><td class=\"item-cell\">{{ item_name }}</td><td class=\"c\">{{ color }}</td><td class=\"n\">{{ width_m | number }}</td><td class=\"n\">{{ height_m | number }}</td><td class=\"n\">{{ set_count | number }}</td><td class=\"n\">{{ qty | number2 }}</td><td class=\"c\">{{ uom }}</td><td class=\"warehouse-cell\">{{ warehouse }}</td><td class=\"n\">{{ weight_kg | number2 }}</td></tr>{{/each}}",
        "</tbody></table>",
        "<div class=\"handover\"><div class=\"handover-title\">Kết quả bàn giao / lắp đặt</div><div class=\"checks\"><span>☐ Đủ số lượng</span><span>☐ Ngoại quan đạt</span><span>☐ Lắp đặt hoàn tất</span><span>☐ Vận hành thử đạt</span><span>☐ Cần xử lý bổ sung</span></div></div>",
        "<div class=\"footer-note\"><b>Ghi chú:</b>{{ note }}</div>",
        "<div class=\"sign\"><div><b>Thủ kho / Người giao</b>(ký, ghi rõ họ tên)</div><div><b>Đội lắp đặt</b>(ký, ghi rõ họ tên)</div><div><b>Khách hàng xác nhận</b>(ký, ghi rõ họ tên)</div></div>"
