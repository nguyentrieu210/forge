      ],
      "html": [
        "<div class=\"letterhead\"><div class=\"brand-logo-text\">ALUMDOOR</div><div class=\"brand-tagline\">CỬA CUỐN CÔNG NGHỆ ĐỨC / ÚC</div><img class=\"company-header-img\" src=\"/alumdoor-company-header.png\" alt=\"Thông tin công ty ALUMDOOR\"></div>",
        "<div class=\"title\">PHIẾU CẮT NHÔM</div>",
        "<div class=\"meta\">",
        "<div class=\"meta-row\"><span class=\"meta-label\">Số phiếu:</span><span class=\"meta-value\">{{ name }}</span></div>",
        "<div class=\"meta-row\"><span class=\"meta-label\">Ngày cắt:</span><span class=\"meta-value\">{{ cut_on | date }}</span></div>",
        "<div class=\"meta-row\"><span class=\"meta-label\">Công thức:</span><span class=\"meta-value\">{{ cutting_policy }}</span></div>",
        "<div class=\"meta-row\"><span class=\"meta-label\">Trạng thái:</span><span class=\"meta-value\">{{ cut_state }}</span></div>",
        "<div class=\"meta-row\"><span class=\"meta-label\">Khách hàng:</span><span class=\"meta-value\">{{ customer }}</span></div>",
        "<div class=\"meta-row\"><span class=\"meta-label\">Theo đơn:</span><span class=\"meta-value\">{{ so_reference }}</span></div>",
        "<div class=\"meta-row\"><span class=\"meta-label\">Work Order:</span><span class=\"meta-value\">{{ work_order }}</span></div>",
        "<div class=\"meta-row\"><span class=\"meta-label\">Màu đích:</span><span class=\"meta-value\">{{ target_color }}</span></div>",
        "</div>",
        "<table><colgroup><col style=\"width:3%\"><col style=\"width:8%\"><col style=\"width:17%\"><col style=\"width:11%\"><col style=\"width:7%\"><col style=\"width:7%\"><col style=\"width:6%\"><col style=\"width:6%\"><col style=\"width:7%\"><col style=\"width:7%\"><col style=\"width:7%\"><col style=\"width:7%\"><col style=\"width:7%\"></colgroup><thead><tr>",
        "<th class=\"index-col\">STT</th><th>Mã nhôm</th><th>Bundle lô mẹ / đầu thừa</th><th>Kho lô mẹ</th><th>Khổ cây (m)</th><th>Rộng cắt (m)</th><th>Số lá</th><th>Số nhát</th><th>Kerf (m)</th><th>Kg tiêu hao</th><th>Kg cân thật</th><th>Đầu thừa (m)</th><th>Phế (m)</th>",
        "</tr></thead><tbody>",
        "{{#each items}}<tr><td class=\"c index-col\">{{ _index }}</td><td class=\"code\">{{ item_code }}</td><td class=\"bundle-cell\">{{ serial_and_batch_bundle }}<br><span class=\"muted\">Đầu thừa: {{ offcut_bundle }}</span></td><td class=\"warehouse-cell\">{{ source_warehouse }}</td><td class=\"n\">{{ source_length_m | number }}</td><td class=\"n\">{{ cut_width_m | number }}</td><td class=\"n\">{{ sheets_cut | number }}</td><td class=\"n\">{{ cuts_count | number }}</td><td class=\"n\">{{ kerf_total_m | number }}</td><td class=\"n\">{{ kg_consumed | number2 }}</td><td class=\"n\">{{ kg_weighed | number2 }}</td><td class=\"n\">{{ offcut_length_m | number }}</td><td class=\"n\">{{ scrap_m | number }}</td></tr>{{/each}}",
        "</tbody></table>",
        "<div class=\"trace\"><b>Truy vết:</b>Bundle lô mẹ và bundle nhập đầu thừa được in trực tiếp từ chứng từ. Không dùng mã tự sinh ngoài sổ lô.</div>",
        "<div class=\"footer-note\"><b>Lý do hoàn / trả:</b>{{ cancel_reason }}<br><b>Ghi chú:</b>{{ note }}</div>",
        "<div class=\"sign\"><div><b>Người cắt</b>(ký, ghi rõ họ tên)</div><div><b>Thủ kho xác nhận</b>(ký, ghi rõ họ tên)</div><div><b>Quản đốc / KCS</b>(ký, ghi rõ họ tên)</div></div>"
      ]
    }
  ]
}
