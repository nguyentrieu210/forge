{
  "$schema": "./brief.schema.json",
  "id": "center",
  "name": "CloudForge Center",
  "version": "1.11.0",
  "module": "Trung tâm",
  "domain": "center",
  "brand": "blue",
  "//locale": [
    "boot.sysdefaults.currency của tenant đang RỖNG, nên client không biết định dạng tiền",
    "và in ra số trần (400000 thay vì 400.000 ₫). App tự khai — mergeLocale ghép đè từng",
    "field lên sysdefaults nên chỉ ép currency, không đụng date/number format của site."
  ],
  "locale": { "currency": "VND", "numberFormat": "#.###,##", "dateFormat": "dd-mm-yyyy" },

  "//scope": [
    "PHA 1 + PHA 2 của MASTER PROMPT: nền, vai trò, master data, ghi danh, buổi học, điểm danh.",
    "KHÔNG có học phí/công nợ/tiền dạy — những thứ đó phải TÍNH rồi GHI SỔ, không khai bằng",
    "dữ liệu được, và spec §10.1 đặt ra bất biến tiền tệ mà chỉ code mới thi hành nổi.",
    "Tên DocType để tiếng Anh, nhãn tiếng Việt — đúng quy ước các app sẵn có, và tránh",
    "chuyện mã hoá URL với tên có dấu."
  ],

  "//dimensions": [
    "CỐ Ý không khai `dimensions`. Một chiều dữ liệu toàn cục mà tenant chưa có master data",
    "sẽ chặn shell ở màn 'Cần chọn phạm vi dữ liệu' vĩnh viễn. Phạm vi theo cơ sở ở đây đi",
    "qua DocType `Branch` + phân quyền, không qua selector toàn cục."
  ],

  "roles": [
    "Chủ trung tâm",
    "Quản lý trung tâm",
    "Lễ tân",
    "Kế toán",
    "Giáo viên",
    "Trợ giảng",
    "Kiểm toán viên"
  ],

  "home": "approval:Enrollment",

  "//worker": [
    "App Worker RIÊNG của Center — thứ brief không nói được: luật phải TÍNH rồi mới quyết.",
    "Chống trùng phòng/giáo viên và chặn vượt sĩ số phải đếm dữ liệu hiện có, nên không",
    "khai bằng metadata được. Worker không giữ quyền nào: nó đọc/ghi qua gateway với danh",
    "tính của chính người dùng vừa gọi, trong đúng một lời gọi."
  ],
  "worker": "cloudforge-app-center",

  "//validators": [
    "Khai ở đây là FAIL-CLOSED: validator không trả lời được thì lệnh ghi bị TỪ CHỐI, không",
    "được thả qua. Đó là hành vi đúng cho một luật nghiệp vụ, nhưng nó có nghĩa hai doctype",
    "này phụ thuộc vào việc Worker gọi ngược được vào nền tảng. Chặng đó đi qua service",
    "binding tới gateway (xem apps-src/center-worker/wrangler.jsonc) chứ không qua mạng."
  ],
  "validators": [
    { "doctype": "Class Session" },
    { "doctype": "Enrollment", "actions": ["create"] }
  ],

  "fixtures": [
    { "type": "Company", "name": "Hải Đăng", "data": { "label": "Trung tâm Ngoại ngữ Hải Đăng", "abbr": "HD", "default_currency": "VND" } }
  ],

