
node_modules/
dist/
.wrangler/
.dev.vars
*.log
.DS_Store
coverage/

# Source-exact upstream evidence: derived from GPL-3.0 ERPNext / MIT Frappe source,
# regenerable via `npm run source:fetch` / `npm run oracle:o2c`. Kept local.
docs/spec/source-exact/generated/
# Oracle per-fixture / per-differential artifacts (regenerable via `npm run oracle:o2c`).
# The summaries (fixture-matrix.json, differential-report.json, ORACLE_REPORT.json) are kept.
docs/spec/source-exact/oracle/fixtures/O2C-*.json
docs/spec/source-exact/oracle/differential/O2C-*.json
docs/spec/source-exact/runtime/

# Packed app output — regenerable from apps-src/ via `npm run app:pack`
apps-src/**/*-[0-9]*.json

# Local wrangler dev artefacts — regenerable, and .dev.vars holds local secrets
apps/*/.dev.vars
wrangler-dev.log
seed-local.sql
cookies.txt
.httpcheck/

# Staged client bundle — generated by scripts/stage-client-bundle.mjs from the
# runtime app in ../client. Deployed with the gateway, never edited by hand.
apps/gateway-worker/public/

# Tenant operations: SQL contains customer data; generated configs pin account IDs.
backups/
apps/tenant-worker/wrangler.*.generated.jsonc
