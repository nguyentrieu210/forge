operational_router_path.write_text('''import type { Actor, JsonObject, MutationCommand, MutationReceipt } from "../../../packages/contracts/src/index.js";
import type { TenantEnv } from "./env.js";
import {
  isStockOperationalFrappePath,
  matchStockOperationalRoute,
  routeStockOperationalRequest,
  type StockOperationalRoute,
} from "./operational-stock-routes.js";
import {
  isManufacturingOperationalFrappePath,
  matchManufacturingOperationalRoute,
  routeManufacturingOperationalRequest,
  type ManufacturingOperationalRoute,
} from "./operational-manufacturing-routes.js";

export type TenantOperationalRoute =
  | { kind: "stock"; route: StockOperationalRoute }
  | { kind: "manufacturing"; route: ManufacturingOperationalRoute };

export function matchTenantOperationalRoute(pathname: string): TenantOperationalRoute | null {
  const stock = matchStockOperationalRoute(pathname);
  if (stock) return { kind: "stock", route: stock };
  const manufacturing = matchManufacturingOperationalRoute(pathname);
  return manufacturing ? { kind: "manufacturing", route: manufacturing } : null;
}

export function isTenantOperationalFrappePath(pathname: string): boolean {
  return isStockOperationalFrappePath(pathname) || isManufacturingOperationalFrappePath(pathname);
}

interface TenantOperationalRequest {
  request: Request;
  url: URL;
  env: TenantEnv;
  tenantId: string;
  actor: Actor;
  traceId: string;
  route: TenantOperationalRoute;
  runCommand(command: MutationCommand): Promise<MutationReceipt>;
  createDocument(doctype: string, document: JsonObject): Promise<Response>;
}

export function routeTenantOperationalRequest(input: TenantOperationalRequest): Promise<Response | null> {
  if (input.route.kind === "stock") {
    return routeStockOperationalRequest({
      request: input.request,
      url: input.url,
      env: input.env,
      tenantId: input.tenantId,
      actor: input.actor,
      traceId: input.traceId,
      route: input.route.route,
      runCommand: input.runCommand,
    });
  }
  return routeManufacturingOperationalRequest({
    request: input.request,
    url: input.url,
    env: input.env,
    tenantId: input.tenantId,
    actor: input.actor,
    traceId: input.traceId,
    route: input.route.route,
    createDocument: input.createDocument,
  });
}
''')

account_path.write_text('''import { D1UserStore } from "../../../packages/auth/src/index.js";
import type { Actor } from "../../../packages/contracts/src/index.js";
import { errors } from "../../../packages/core/src/index.js";
import {
  isMfaRoutePath,
  isPublicFrappePath,
  isSessionManagementPath,
  routeFrappeAuth,
  routeMfaApi,
  routeSessionManagementApi,
  slideSession,
  type AuthRouteContext,
  type EstablishedSession,
} from "../../../packages/frappe-api/src/index.js";
import type { TenantEnv } from "./env.js";
import { mfaKeyRingFromEnv } from "./mfa-config.js";

export type AccountSecurityRoute = "public-auth" | "mfa" | "sessions";

export interface InterceptedRouteAuthentication {
  actor: Actor;
  established?: EstablishedSession;
  authContext?: AuthRouteContext;
}

export function matchAccountSecurityRoute(pathname: string): AccountSecurityRoute | null {
  if (isPublicFrappePath(pathname)) return "public-auth";
  if (isMfaRoutePath(pathname)) return "mfa";
  if (isSessionManagementPath(pathname)) return "sessions";
  return null;
}

export function isAccountSecurityFaultPath(pathname: string): boolean {
  return matchAccountSecurityRoute(pathname) !== null;
}

export function isAccountSecurityCookieBoundPath(pathname: string): boolean {
  const route = matchAccountSecurityRoute(pathname);
  return route === "mfa" || route === "sessions";
}

export function createAccountAuthContext(
  request: Request,
  env: TenantEnv,
  tenantId: string,
  traceId: string,
): AuthRouteContext {
  return {
    tenantId,
    users: new D1UserStore(env.DB, mfaKeyRingFromEnv(env)),
    sessionSecret: env.SESSION_SECRET ?? "",
    traceId,
    now: () => new Date().toISOString(),
    rateLimit: {
      db: env.DB,
      salt: env.INTERNAL_AUTH_SECRET,
      clientAddress: request.headers.get("CF-Connecting-IP") ?? "unknown",
    },
  };
}

export function routePublicAccountSecurityRequest(
  request: Request,
  url: URL,
  env: TenantEnv,
  tenantId: string,
  traceId: string,
): Promise<Response | null> {
  return routeFrappeAuth(request, url, createAccountAuthContext(request, env, tenantId, traceId));
}

interface AuthenticatedAccountSecurityRequest {
  request: Request;
  url: URL;
  env: TenantEnv;
  tenantId: string;
  traceId: string;
  route: AccountSecurityRoute;
  authentication: InterceptedRouteAuthentication;
}

export async function routeAuthenticatedAccountSecurityRequest(input: AuthenticatedAccountSecurityRequest): Promise<Response | null> {
  const { request, url, tenantId, traceId, route, authentication } = input;
  const established = authentication.established;
  const authContext = authentication.authContext;
  if (!established || !authContext) throw errors.permission("A browser session is required for account security management");

  if (route === "mfa") {
    return routeMfaApi(request, url, {
      tenantId,
      actor: established.actor,
      traceId,
      authenticatedAt: established.session.authenticatedAt,
      now: authContext.now(),
      mfa: authContext.users.mfa,
    });
  }
  if (route !== "sessions") return null;
  return routeSessionManagementApi(request, url, {
    tenantId,
    userId: established.actor.user_id,
    traceId,
    now: authContext.now(),
    sessions: authContext.users.sessions,
    ...(established.session.sessionId ? { currentSessionId: established.session.sessionId } : {}),
    revokeAllSessions: () => authContext.users.administration.revokeSessions(
      tenantId,
      established.actor.user_id,
      {
        actorUserId: established.actor.user_id,
        traceId,
        source: "metaforge.api.logout_other_sessions",
      },
      authContext.now(),
    ),
  });
}

export async function refreshAuthenticatedSession(
  response: Response,
  authentication: InterceptedRouteAuthentication,
): Promise<void> {
  if (!authentication.established || !authentication.authContext) return;
  const refreshed = await slideSession(authentication.established, authentication.authContext);
  if (refreshed) response.headers.append("set-cookie", refreshed);
}
''')

